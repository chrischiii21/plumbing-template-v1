---
// Floating offer button that triggers the popup modal
// Only visible on desktop (md and up), hides when scrolled to bottom
---

<div id="free-scan-wrapper" class="hidden md:block fixed bottom-8 right-8 z-40">
  <button
    id="free-scan-trigger"
    class="clay-trigger relative flex items-center bg-white rounded-full transition-all duration-500 group pr-8 overflow-visible"
    aria-label="Get $50 off your next service"
  >
    {/* Soft Clay Glow Ring */}
    <span class="clay-glow-ring absolute inset-0 rounded-full"></span>
    <span class="clay-glow-ping absolute inset-0 rounded-full border-2 border-[#3B82F6]/30"></span>

    {/* Puffy Icon Circle */}
    <span class="relative flex items-center justify-center w-16 h-16 rounded-full flex-shrink-0 clay-icon-housing shadow-clayButton">
      <svg
        class="w-7 h-7 text-white group-hover:scale-110 transition-transform duration-300 drop-shadow-[0_2px_4px_rgba(0,0,0,0.2)]"
        fill="none"
        stroke="currentColor"
        viewBox="0 0 24 24"
      >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5"
          d="M12 8v13m0-13V6a2 2 0 112 2h-2zm0 0V5.5A2.5 2.5 0 109.5 8H12zm-7 4h14M5 12a2 2 0 110-4h14a2 2 0 110 4M5 12v7a2 2 0 002 2h10a2 2 0 002-2v-7" />
      </svg>
      {/* Puffy Status Dot */}
      <span class="absolute top-1 right-1 w-3.5 h-3.5 rounded-full bg-[#16A34A] border-2 border-white shadow-clayButton"></span>
    </span>

    {/* Text content - Montserrat & Poppins */}
    <span class="flex flex-col items-start pl-4 py-2 leading-tight">
      <span class="text-[9px] font-black uppercase tracking-[0.2em] text-[#3B82F6] mb-0.5" style="font-family: 'JetBrains Mono', monospace;">Limited Offer</span>
      <span class="text-base font-black tracking-tight text-[#1C398E]" style="font-family: 'Poppins', sans-serif;">$50 OFF — Claim Now</span>
    </span>
  </button>
</div>

<style>
  #free-scan-wrapper {
    animation: slide-up 0.6s cubic-bezier(0.175, 0.885, 0.32, 1.275) 1s both;
  }

  @keyframes slide-up {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .clay-trigger {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.12),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8),
      inset -4px -4px 8px rgba(28, 57, 142, 0.02);
  }

  .clay-trigger:hover {
    transform: translateY(-4px) scale(1.02);
    box-shadow: 
      16px 16px 32px rgba(28, 57, 142, 0.15),
      -8px -8px 16px rgba(255, 255, 255, 1);
  }

  .clay-trigger:active {
    transform: scale(0.96);
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.1),
      inset -6px -6px 12px rgba(255, 255, 255, 1);
  }

  .clay-icon-housing {
    background: #3B82F6;
    box-shadow: 
      inset 4px 4px 8px rgba(255, 255, 255, 0.4),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1);
  }

  .shadow-clayButton {
    box-shadow: 
      4px 4px 8px rgba(28, 57, 142, 0.1),
      -4px -4px 8px rgba(255, 255, 255, 1);
  }

  /* Soft Clay Glow */
  .clay-glow-ping {
    animation: clay-ping 3s cubic-bezier(0, 0, 0.2, 1) infinite;
  }

  @keyframes clay-ping {
    0% { transform: scale(1); opacity: 0.6; }
    75%, 100% { transform: scale(1.2); opacity: 0; }
  }

  @media (prefers-reduced-motion: reduce) {
    .clay-glow-ping { animation: none; }
    #free-scan-wrapper { animation: none; opacity: 1; }
  }
</style>
