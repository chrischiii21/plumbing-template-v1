---
import { siteConfig, getLocationText } from "@/config/brand-settings"

interface Props {
  delay?: number;
  showOnce?: boolean;
  triggerId?: string;
}

const {
  delay = 5000,
  showOnce = true,
  triggerId = "free-scan-trigger",
} = Astro.props;

const phoneRaw = siteConfig.contact.phone;
const phoneFormatted = siteConfig.contact.phoneFormatted;
---

<div
  id="popup-modal"
  class="fixed inset-0 z-[100] hidden items-center justify-center bg-[#1C398E]/40 backdrop-blur-md transition-all duration-500"
  role="dialog"
  aria-modal="true"
  aria-labelledby="popup-title"
  data-delay={delay}
  data-show-once={showOnce}
  data-trigger-id={triggerId}
>
  <div class="clay-popup relative w-full max-w-[440px] mx-4 bg-white rounded-[40px] shadow-clayCard overflow-hidden animate-clay-bounce p-2">
    
    {/* Decorative Background Blobs */}
    <div class="absolute -top-10 -left-10 w-32 h-32 bg-[#3B82F6]/10 rounded-full blur-2xl pointer-events-none"></div>
    <div class="absolute -bottom-10 -right-10 w-32 h-32 bg-[#16A34A]/10 rounded-full blur-2xl pointer-events-none"></div>

    <div class="relative bg-white rounded-[32px] overflow-hidden">
      <!-- Close button -->
      <button
        id="close-popup"
        class="absolute top-4 right-4 z-20 w-10 h-10 flex items-center justify-center rounded-full bg-white shadow-clayButton hover:shadow-clayPressed text-[#1C398E] transition-all duration-300"
        aria-label="Close popup"
      >
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>

      <!-- Hero image banner with clay inset -->
      <div class="relative h-56 m-2 rounded-[24px] overflow-hidden shadow-clayInner">
        <img
          src="/images/photos/ucare-315825d3-1000x666.jpg"
          alt="Professional plumbing team"
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
          width="440"
          height="224"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-[#1C398E]/80 to-transparent"></div>

        <!-- Discount overlay on image -->
        <div class="absolute bottom-0 left-0 right-0 p-8 text-center">
          <div class="inline-block bg-[#16A34A] text-white text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest shadow-clayButton mb-3">
            New Customer Special
          </div>
          <div class="text-6xl font-black text-white tracking-tight leading-none mb-1" style="font-family: 'Poppins', sans-serif;">$50 OFF</div>
          <p class="text-white/80 text-sm font-medium" style="font-family: 'Montserrat', sans-serif;">Any service of $500 or more</p>
        </div>
      </div>

      <!-- Content -->
      <div class="px-8 pt-4 pb-10 space-y-8 text-center">
        <div class="space-y-3">
          <h2 id="popup-title" class="text-2xl font-black text-[#1C398E] leading-tight tracking-tight px-4" style="font-family: 'Poppins', sans-serif;">
            Don't Let Plumbing Problems Wait
          </h2>
          <p class="text-[15px] text-[#1C398E]/60 leading-relaxed font-medium" style="font-family: 'Montserrat', sans-serif;">
            Book today and save. Our licensed pros handle everything from leaks to full remodels.
          </p>
        </div>

        {/* Quick stats row - Puffy Boxes */}
        <div class="grid grid-cols-3 gap-3">
          {[
            { val: "20+", lab: "Years" },
            { val: "24/7", lab: "Service" },
            { val: "5★", lab: "Rated" }
          ].map(stat => (
            <div class="bg-[#3B82F6]/5 rounded-[20px] py-4 shadow-clayInner">
              <div class="text-lg font-black text-[#3B82F6]" style="font-family: 'Poppins', sans-serif;">{stat.val}</div>
              <div class="text-[9px] font-bold text-[#1C398E]/40 uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace;">{stat.lab}</div>
            </div>
          ))}
        </div>

        {/* CTA buttons */}
        <div class="space-y-4 pt-2">
          <a
            href="/contact"
            class="clay-btn-primary block w-full py-5 text-white text-center font-black text-sm uppercase tracking-widest"
          >
            Claim Your $50 Discount
          </a>
          <a
            href={`tel:${phoneRaw}`}
            class="clay-btn-secondary flex items-center justify-center gap-3 w-full py-4 text-[#1C398E] text-center font-black text-xs uppercase tracking-widest"
          >
            <div class="w-8 h-8 rounded-full bg-white shadow-clayButton flex items-center justify-center text-[#3B82F6]">
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                <path d="M20 15.5c-1.25 0-2.45-.2-3.57-.57a1.02 1.02 0 00-1.02.24l-2.2 2.2a15.05 15.05 0 01-6.59-6.59l2.2-2.21a.96.96 0 00.25-1.02A11.36 11.36 0 018.5 4c0-.55-.45-1-1-1H4c-.55 0-1 .45-1 1 0 9.39 7.61 17 17 17 .55 0 1-.45 1-1v-3.5c0-.55-.45-1-1-1zM19 12h2a9 9 0 00-9-9v2c3.87 0 7 3.13 7 7zm-4 0h2a5 5 0 00-5-5v2c1.66 0 3 1.34 3 3z"/>
              </svg>
            </div>
            Call Now: {phoneFormatted}
          </a>
        </div>

        <!-- Dismiss -->
        <button
          id="close-popup-bottom"
          class="text-[10px] font-bold text-[#1C398E]/40 uppercase tracking-widest hover:text-[#3B82F6] transition-colors"
          style="font-family: 'JetBrains Mono', monospace;"
        >
          Maybe later
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  let popupTimeoutId;

  function showPopup() {
    const popup = document.getElementById("popup-modal");
    if (!popup) return;
    popup.classList.remove("hidden");
    popup.classList.add("flex");
    document.body.style.overflow = "hidden";
    
    const showOnce = popup.getAttribute("data-show-once") === "true";
    if (showOnce) {
      sessionStorage.setItem("popup-shown", "true");
    }
  }

  function closePopup() {
    const popup = document.getElementById("popup-modal");
    if (!popup) return;
    popup.classList.add("hidden");
    popup.classList.remove("flex");
    document.body.style.overflow = "";
  }

  function initPopup() {
    const popup = document.getElementById("popup-modal");
    if (!popup) return;

    // Clear any existing timeouts from previous page loads to prevent race conditions
    if (popupTimeoutId) {
      clearTimeout(popupTimeoutId);
    }

    const alreadyShown = sessionStorage.getItem("popup-shown") === "true";
    const showOnce = popup.getAttribute("data-show-once") === "true";
    const triggerId = popup.getAttribute("data-trigger-id");

    document.getElementById("close-popup")?.addEventListener("click", closePopup);
    document.getElementById("close-popup-bottom")?.addEventListener("click", closePopup);
    popup.addEventListener("click", (e) => { if (e.target === popup) closePopup(); });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && !popup.classList.contains("hidden")) closePopup();
    });

    if (triggerId) {
      document.getElementById(triggerId)?.addEventListener("click", (e) => {
        e.preventDefault();
        showPopup();
      });
    }

    const delay = parseInt(popup.getAttribute("data-delay") || "0") || 0;
    
    // Automatically trigger if it has a delay, and either showOnce is false, or it hasn't been shown yet.
    if (delay > 0 && (!showOnce || !alreadyShown)) {
      popupTimeoutId = setTimeout(() => {
        showPopup();
      }, delay);
    }
  }

  // Run on initial load and subsequent navigations
  document.addEventListener("astro:page-load", initPopup);
</script>

<style>
  /* Clay Shadows & Effects */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.15),
      -12px -12px 24px rgba(255, 255, 255, 1),
      inset 4px 4px 10px rgba(255, 255, 255, 0.8),
      inset -4px -4px 10px rgba(28, 57, 142, 0.05);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.1),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 2px 2px 4px rgba(255, 255, 255, 0.6),
      inset -2px -2px 4px rgba(28, 57, 142, 0.03);
  }

  .shadow-clayPressed {
    box-shadow: 
      inset 4px 4px 8px rgba(28, 57, 142, 0.1),
      inset -4px -4px 8px rgba(255, 255, 255, 1);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.08),
      inset -6px -6px 12px rgba(255, 255, 255, 1);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 24px;
    box-shadow: 
      8px 8px 16px rgba(59, 130, 246, 0.3),
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .clay-btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .clay-btn-primary:active {
    transform: scale(0.95);
    box-shadow: inset 6px 6px 12px rgba(0, 0, 0, 0.2);
  }

  .clay-btn-secondary {
    background: #FFFFFF;
    border-radius: 24px;
    box-shadow: 
      8px 8px 16px rgba(28, 57, 142, 0.08),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.6),
      inset -4px -4px 8px rgba(28, 57, 142, 0.03);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .clay-btn-secondary:hover {
    transform: translateY(-2px);
  }

  .clay-btn-secondary:active {
    transform: scale(0.95);
    box-shadow: inset 4px 4px 8px rgba(28, 57, 142, 0.1);
  }

  @keyframes clay-bounce {
    0% { transform: scale(0.9) translateY(20px); opacity: 0; }
    70% { transform: scale(1.05) translateY(-5px); }
    100% { transform: scale(1) translateY(0); opacity: 1; }
  }
  .animate-clay-bounce {
    animation: clay-bounce 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
  }
</style>
