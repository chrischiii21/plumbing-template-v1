---
import { Phone, ArrowRight, ShieldAlert, CalendarClock, CreditCard } from "lucide-react";
import { getLocationText } from "@/config/brand-settings"

interface PromoTile {
  type: "maintenance" | "financing" | "emergency";
  tag?: string;
  title?: string;
  priceLabel?: string[];
  headline?: string[];
  subtext?: string;
  discount?: string;
  subheadline?: string[];
  phone?: string;
  buttonText: string;
  buttonHref?: string;
  bgImage?: string;
}

interface Props {
  tiles: PromoTile[];
}

const { tiles: rawTiles } = Astro.props;

// Process all text in tiles through getLocationText
const tiles = rawTiles.map(tile => ({
  ...tile,
  tag: tile.tag ? getLocationText(tile.tag) : undefined,
  title: tile.title ? getLocationText(tile.title) : undefined,
  priceLabel: tile.priceLabel ? tile.priceLabel.map(getLocationText) : undefined,
  headline: tile.headline ? tile.headline.map(getLocationText) : undefined,
  subtext: tile.subtext ? getLocationText(tile.subtext) : undefined,
  discount: tile.discount ? getLocationText(tile.discount) : undefined,
  subheadline: tile.subheadline ? tile.subheadline.map(getLocationText) : undefined,
  phone: tile.phone ? getLocationText(tile.phone) : undefined,
  buttonText: getLocationText(tile.buttonText),
}));
---

<section class="py-16 md:py-32 bg-[#F8FAFC] overflow-hidden">
  <div class="container mx-auto px-4 relative z-10">
    {/* Creative Fanned Grid: 3 equal columns side by side */}
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8 max-w-7xl mx-auto items-center perspective-1000" data-animate-stagger>
      {tiles.map((tile, i) => {
        const isEmergency = tile.type === 'emergency';
        const isFinancing = tile.type === 'financing';
        const isMaintenance = tile.type === 'maintenance';
        
        const cardClass = isEmergency 
          ? 'bg-rose-600 text-white shadow-[0_20px_40px_rgba(225,29,72,0.2)] border border-rose-500' 
          : isFinancing 
          ? 'bg-[#3B82F6] text-white shadow-[0_30px_60px_rgba(59,130,246,0.3)] border border-blue-400' 
          : 'bg-white text-[#1C398E] shadow-clayCard border border-white';

        const btnClass = isEmergency
          ? 'bg-white text-rose-600 hover:bg-rose-50 shadow-[0_10px_20px_rgba(255,255,255,0.3)]'
          : isFinancing
          ? 'bg-white text-[#3B82F6] hover:bg-blue-50 shadow-[0_10px_20px_rgba(255,255,255,0.3)]'
          : 'bg-[#3B82F6] text-white hover:bg-[#2563EB] shadow-[0_8px_20px_rgba(59,130,246,0.3)]';
          
        const badgeClass = isEmergency || isFinancing
          ? 'bg-white/20 text-white border border-white/30 backdrop-blur-md'
          : 'bg-[#f8faff] text-[#3B82F6] shadow-clayInner border border-white';

        // Clean, elegant transform logic
        let transformClass = '';
        if (i === 0) transformClass = 'hover:-translate-y-3';
        if (i === 1) transformClass = 'lg:scale-105 lg:-translate-y-2 z-10 hover:-translate-y-5';
        if (i === 2) transformClass = 'hover:-translate-y-3';

        return (
          <div class={`relative overflow-hidden rounded-[32px] md:rounded-[40px] p-8 lg:p-10 flex flex-col h-full group transition-all duration-500 ease-out will-change-transform transform-gpu hover:z-50 hover:shadow-2xl text-center ${cardClass} ${transformClass}`}>
            
            {/* Background Image Overlay */}
            {tile.bgImage && (
              <div class="absolute inset-0 opacity-[0.12] mix-blend-overlay pointer-events-none group-hover:scale-105 group-hover:opacity-[0.20] transition-all duration-700 ease-out">
                <img src={tile.bgImage} alt="" class="w-full h-full object-cover" />
              </div>
            )}
            
            {/* Decorative Glow */}
            <div class={`absolute -top-24 -right-24 w-64 h-64 rounded-full blur-[80px] pointer-events-none transition-transform duration-700 ease-out group-hover:scale-125 ${isMaintenance ? 'bg-blue-100' : 'bg-white/20'}`}></div>

            <div class="relative z-10 flex flex-col h-full transform-gpu">
              
              {/* Header/Tag */}
              <div class="mb-6 flex justify-center">
                {(tile.tag || tile.title) && (
                  <div class={`inline-flex items-center gap-2 px-4 py-1.5 rounded-full ${badgeClass}`}>
                    {isEmergency && <ShieldAlert class="w-3.5 h-3.5" />}
                    {isFinancing && <CreditCard class="w-3.5 h-3.5" />}
                    {isMaintenance && <CalendarClock class="w-3.5 h-3.5" />}
                    <span class="font-black tracking-[0.15em] uppercase text-[10px] md:text-[11px]" style="font-family: 'JetBrains Mono', monospace;">
                      {tile.tag || tile.title}
                    </span>
                  </div>
                )}
              </div>

              {/* Content Area */}
              <div class="flex-grow flex flex-col justify-center">
                {isMaintenance ? (
                  <div class="mb-4">
                    {tile.priceLabel?.map((line, idx) => {
                      if (idx === 1) {
                        return (
                          <div class="bg-[#F0F4F9] rounded-[24px] py-6 px-4 my-4 shadow-[inset_2px_2px_8px_rgba(0,0,0,0.05),inset_-2px_-2px_8px_rgba(255,255,255,0.8)] border border-white/50 transform-gpu transition-transform duration-500 ease-out group-hover:scale-105">
                            <p class="text-5xl lg:text-[56px] font-black text-[#1C398E] tracking-tighter leading-none text-center">
                              {line}
                            </p>
                          </div>
                        )
                      }
                      return (
                        <p class="text-xs font-bold uppercase tracking-widest text-[#3B82F6] text-center">
                          {line}
                        </p>
                      )
                    })}
                  </div>
                ) : isFinancing ? (
                  <div class="mb-4">
                    <div class="bg-white/10 backdrop-blur-sm rounded-[24px] py-6 px-5 mb-4 border border-white/20 shadow-[inset_0_2px_20px_rgba(255,255,255,0.1)] transform-gpu transition-transform duration-500 ease-out group-hover:scale-105">
                      {tile.headline?.map((line, idx) => (
                        <p class={`text-3xl lg:text-[40px] font-black text-white leading-[1.05] uppercase tracking-tight text-center ${idx === 0 ? "mb-1" : "mb-1"}`}>{line}</p>
                      ))}
                    </div>
                    {tile.subtext && (
                      <p class="text-[11px] font-bold text-white/90 uppercase tracking-wider leading-relaxed bg-black/15 inline-block px-4 py-2 rounded-xl backdrop-blur-sm">{tile.subtext}</p>
                    )}
                  </div>
                ) : (
                  <div class="mb-4">
                    {tile.discount && (
                      <div class="bg-rose-700/40 backdrop-blur-sm rounded-[24px] py-6 px-4 mb-4 border border-rose-400/30 shadow-[inset_0_2px_20px_rgba(255,255,255,0.1)] transform-gpu transition-transform duration-500 ease-out group-hover:scale-105">
                        <p class="text-6xl md:text-7xl font-black text-white tracking-tighter drop-shadow-md text-center leading-none">{tile.discount}</p>
                      </div>
                    )}
                    {tile.subheadline?.map((line) => (
                      <p class="text-xl lg:text-2xl font-black text-white/95 uppercase tracking-tight mb-1 text-center">{line}</p>
                    ))}
                  </div>
                )}
              </div>

              {/* Footer Area */}
              <div class={`mt-6 pt-6 border-t ${isEmergency ? 'border-white/20' : 'border-current/10'}`}>
                <a 
                  href={tile.buttonHref || (isFinancing ? '/financing' : '/contact')} 
                  class={`w-full inline-flex items-center justify-center gap-3 px-6 h-14 rounded-full text-[11px] font-black uppercase tracking-widest transition-all duration-300 ${btnClass}`}
                >
                  {tile.buttonText}
                  <ArrowRight className="w-4 h-4 group-hover:translate-x-1.5 transition-transform" />
                </a>
                
                {tile.phone && (
                  <div class="mt-4 flex items-center justify-center gap-2 text-[10px] font-black tracking-widest uppercase opacity-80">
                    <Phone className="w-3.5 h-3.5" />
                    <span>Call {tile.phone}</span>
                  </div>
                )}
              </div>
            </div>
            
          </div>
        );
      })}
    </div>
  </div>
</section>
