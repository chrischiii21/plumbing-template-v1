---
import { Phone, ArrowRight } from "lucide-react";
import { getLocationText } from "@/config/brand-settings"

interface PromoTile {
  type: "maintenance" | "financing" | "emergency";
  tag?: string;
  title?: string;
  priceLabel?: string[];
  headline?: string[];
  subtext?: string;
  discount?: string;
  subheadline?: string[];
  phone?: string;
  buttonText: string;
  buttonHref?: string;
  bgImage?: string;
}

interface Props {
  tiles: PromoTile[];
}

const { tiles: rawTiles } = Astro.props;

// Process all text in tiles through getLocationText
const tiles = rawTiles.map(tile => ({
  ...tile,
  tag: tile.tag ? getLocationText(tile.tag) : undefined,
  title: tile.title ? getLocationText(tile.title) : undefined,
  priceLabel: tile.priceLabel ? tile.priceLabel.map(getLocationText) : undefined,
  headline: tile.headline ? tile.headline.map(getLocationText) : undefined,
  subtext: tile.subtext ? getLocationText(tile.subtext) : undefined,
  discount: tile.discount ? getLocationText(tile.discount) : undefined,
  subheadline: tile.subheadline ? tile.subheadline.map(getLocationText) : undefined,
  phone: tile.phone ? getLocationText(tile.phone) : undefined,
  buttonText: getLocationText(tile.buttonText),
}));
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-12 md:py-20 bg-[#F8FAFC]">
  <div class="container mx-auto px-4">
    <div class="grid lg:grid-cols-3 gap-8" data-animate-stagger>
      {tiles.map((tile) => (
        <div class={`clay-card group relative overflow-hidden flex flex-col h-full will-change-transform ${tile.type === 'emergency' ? 'clay-card-accent' : ''}`}>
          <!-- Background Image Overlay (Subtle) -->
          {tile.bgImage && (
            <div class="absolute inset-0 opacity-[0.03] grayscale pointer-events-none group-hover:opacity-[0.08] transition-all duration-700">
              <img src={tile.bgImage} alt="" class="w-full h-full object-cover" />
            </div>
          )}
          
          <!-- Decorative Blob -->
          <div class={`absolute -top-12 -right-12 w-32 h-32 rounded-full opacity-10 transition-transform duration-700 group-hover:scale-110 ${tile.type === 'maintenance' ? 'bg-blue-400' : tile.type === 'financing' ? 'bg-emerald-400' : 'bg-rose-400'}`}></div>

          <div class="relative z-10 flex flex-col h-full transform-gpu">
            <!-- Header/Tag -->
            <div class="mb-6">
              {(tile.tag || tile.title) && (
                <div class="inline-block px-4 py-1 rounded-full clay-badge mb-4">
                  <span class="text-[0.65rem] font-mono font-bold tracking-widest text-[#3B82F6] uppercase">
                    {tile.tag || tile.title}
                  </span>
                </div>
              )}
            </div>

            <!-- Content Area -->
            <div class="flex-grow">
              {tile.type === "maintenance" ? (
                <div class="mb-8">
                  {tile.priceLabel?.map((line, i) => (
                    <p class={`clay-text ${i === 1 ? "text-4xl md:text-5xl font-black text-[#1C398E] my-3" : "text-xs font-semibold uppercase tracking-wider text-[#3B82F6]/70"}`}>
                      {line}
                    </p>
                  ))}
                </div>
              ) : tile.type === "financing" ? (
                <div class="mb-8">
                  {tile.headline?.map((line) => (
                    <p class="clay-title text-2xl md:text-3xl font-extrabold text-[#1C398E] leading-tight mb-1 uppercase tracking-tight">{line}</p>
                  ))}
                  {tile.subtext && (
                    <p class="clay-subtitle text-sm font-medium text-[#1C398E]/60 mt-3">{tile.subtext}</p>
                  )}
                </div>
              ) : (
                <div class="mb-8">
                  {tile.discount && (
                    <p class="clay-title text-5xl md:text-6xl font-black text-rose-500 mb-3 drop-shadow-sm">{tile.discount}</p>
                  )}
                  {tile.subheadline?.map((line) => (
                    <p class="clay-subtitle text-lg font-bold text-[#1C398E] uppercase tracking-wide">{line}</p>
                  ))}
                </div>
              )}
            </div>

            <!-- Footer Area -->
            <div class="mt-auto pt-8 border-t border-[#1C398E]/5">
              <a 
                href={tile.buttonHref || (tile.type === 'financing' ? '/financing' : '/contact')} 
                class={`clay-button w-full inline-flex items-center justify-center gap-2 px-6 py-4 rounded-2xl font-bold transition-all duration-300 ${tile.type === 'emergency' ? 'bg-rose-500 text-white hover:bg-rose-600 shadow-[0_8px_20px_rgba(244,63,94,0.3)]' : 'bg-[#3B82F6] text-white hover:bg-[#2563EB] shadow-[0_8px_20px_rgba(59,130,246,0.3)]'}`}
              >
                {tile.buttonText}
                {tile.type === 'financing' ? <ArrowRight className="w-5 h-5" /> : <Phone className="w-5 h-5" />}
              </a>
              
              {tile.phone && (
                <div class="mt-4 flex items-center justify-center gap-2 text-xs font-bold font-mono text-[#1C398E]/50 tracking-tighter">
                  <Phone className="w-3.5 h-3.5" />
                  <span>{tile.phone}</span>
                </div>
              )}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3rem;
    padding: 3rem 2rem;
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.02), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-card:hover {
    transform: translateY(-8px) scale(1.02);
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.02), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      25px 50px 90px rgba(28, 57, 142, 0.1);
  }

  .clay-card-accent {
    border-color: rgba(244, 63, 94, 0.1);
  }

  .clay-badge {
    background: rgba(59, 130, 246, 0.05);
    box-shadow: 
      inset -1px -1px 2px rgba(0, 0, 0, 0.05), 
      inset 1px 1px 2px rgba(255, 255, 255, 0.9);
  }

  .clay-button {
    box-shadow: 
      inset -4px -4px 8px rgba(0, 0, 0, 0.1), 
      inset 4px 4px 8px rgba(255, 255, 255, 0.2);
  }

  .clay-button:active {
    transform: scale(0.98);
    box-shadow: 
      inset 4px 4px 8px rgba(0, 0, 0, 0.1), 
      inset -4px -4px 8px rgba(255, 255, 255, 0.2);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle, .clay-text {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Entrance animation */
  [data-animate-stagger] > * {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
