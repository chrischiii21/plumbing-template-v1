---
import { getLocationText } from "@/config/brand-settings"
import { Quote, MessageSquare, CheckCircle2, ArrowRight } from "lucide-react"

interface Review {
  name: string;
  time: string;
  content: string;
  readMoreHref?: string;
}

interface Props {
  badge?: string;
  title: string;
  description?: string;
  reviews: Review[];
  verifiedBy?: string;
}

const { 
  badge: raw_badge = "GOOGLE REVIEW", 
  title: raw_title, 
  description: raw_description, 
  reviews: rawReviews, 
  verifiedBy = "Verified by Trustindex" 
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;
const reviews = rawReviews.map(r => ({
  ...r,
  initials: r.name.split(' ').map(n => n[0]).join('').toUpperCase(),
  content: getLocationText(r.content),
}));
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 bg-[#F8FAFC] relative overflow-hidden border-y border-[#3B82F6]/5">
  {/* Ambient Clay Blobs */}
  <div class="absolute top-0 -left-20 w-96 h-96 bg-[#3B82F6]/5 rounded-full blur-[100px] pointer-events-none animate-pulse"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-[#16A34A]/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
      <div class="inline-flex items-center gap-3 bg-white px-6 py-2 rounded-full clay-badge mb-6">
        <MessageSquare className="w-4 h-4 text-[#3B82F6]" />
        <span class="text-[0.65rem] font-mono font-bold uppercase tracking-[0.25em] text-[#3B82F6]">{badge}</span>
      </div>
      <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] mb-8 tracking-tighter leading-tight uppercase">{title}</h2>
      {description && <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />}
    </div>

    <div class="reviews-carousel overflow-hidden cursor-grab active:cursor-grabbing select-none" data-animate="fade-up">
      <div class="reviews-marquee flex py-10" style="will-change: transform;">
        {/* Render cards twice for seamless loop */}
        {[...reviews, ...reviews].map((review) => (
          <div class="flex-shrink-0 w-[320px] sm:w-[400px] px-5 group">
            <div class="clay-card p-8 group-hover:-translate-y-3 transition-all duration-500 h-full flex flex-col relative overflow-hidden will-change-transform transform-gpu">
              
              {/* Quote Icon Background Accent */}
              <div class="absolute -right-4 -top-4 w-24 h-24 bg-[#3B82F6]/5 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
              <div class="absolute top-8 right-10 text-[#3B82F6]/10 group-hover:text-[#3B82F6]/30 transition-colors">
                <Quote className="w-12 h-12" />
              </div>

              <div class="flex items-center gap-5 mb-8 relative z-10">
                <div class="w-16 h-16 rounded-full bg-white clay-badge flex items-center justify-center border-4 border-white">
                  <span class="clay-title text-xl font-black text-[#3B82F6]">{review.initials}</span>
                </div>
                <div>
                  <p class="clay-title font-black text-[#1C398E] text-lg uppercase tracking-tight leading-tight">{review.name}</p>
                  <p class="text-[10px] font-bold text-[#1C398E]/30 uppercase tracking-widest font-mono mt-1">{review.time}</p>
                </div>
              </div>

              {/* Fixed 5-Star Rating puffy labels */}
              <div class="flex gap-1.5 mb-8 relative z-10">
                {Array.from({ length: 5 }).map((_, i) => (
                  <div class="w-7 h-7 rounded-full flex items-center justify-center bg-[#16A34A] text-white clay-star-badge">
                    <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                    </svg>
                  </div>
                ))}
              </div>

              <div class="clay-inner-card p-6 flex-1 flex flex-col group-hover:bg-white transition-colors duration-500">
                <p class="clay-subtitle text-[15px] text-[#1C398E]/70 font-medium leading-relaxed italic mb-4 flex-grow" set:html={review.content} />
                {review.readMoreHref && (
                  <a href={review.readMoreHref} class="text-[11px] font-black text-[#3B82F6] uppercase tracking-[0.2em] hover:underline flex items-center gap-2">
                    Read Full Review 
                    <ArrowRight className="w-3.5 h-3.5" strokeWidth={3} />
                  </a>
                )}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
    
    {verifiedBy && (
      <div class="text-center mt-12" data-animate="fade-up">
        <div class="inline-flex items-center gap-3 px-8 py-3 bg-white rounded-full clay-badge">
          <CheckCircle2 className="w-5 h-5 text-[#16A34A]" />
          <span class="text-[11px] font-black text-[#1C398E]/40 uppercase tracking-[0.2em] font-mono">{verifiedBy}</span>
        </div>
      </div>
    )}
  </div>
</section>

<script>
  function initReviewsMarquee() {
    document.querySelectorAll<HTMLElement>('.reviews-carousel').forEach((carousel) => {
      const marquee = carousel.querySelector<HTMLElement>('.reviews-marquee');
      if (!marquee) return;

      if (marquee.dataset.init === 'true') return;
      marquee.dataset.init = 'true';

      let offset = 0;
      let speed = 0.5; 
      let paused = false;
      let dragging = false;
      let dragStartX = 0;
      let dragOffsetStart = 0;
      let momentum = 0;
      let rafId: number;

      function wrapOffset() {
        const half = marquee!.scrollWidth / 2;
        if (half > 0) {
          offset = ((offset % half) + half) % half;
        }
      }

      function animate() {
        if (dragging) {
          // Handled by mousemove
        } else if (momentum !== 0) {
          offset += momentum;
          momentum *= 0.95;
          if (Math.abs(momentum) < 0.1) momentum = 0;
        } else if (!paused) {
          offset += speed;
        }
        wrapOffset();
        marquee!.style.transform = `translateX(-${offset}px)`;
        rafId = requestAnimationFrame(animate);
      }

      carousel.addEventListener('mouseenter', () => { paused = true; });
      carousel.addEventListener('mouseleave', () => { paused = false; dragging = false; });

      carousel.addEventListener('mousedown', (e: MouseEvent) => {
        dragging = true;
        paused = true;
        momentum = 0;
        dragStartX = e.clientX;
        dragOffsetStart = offset;
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e: MouseEvent) => {
        if (!dragging) return;
        const delta = dragStartX - e.clientX;
        offset = dragOffsetStart + delta;
      });

      window.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        momentum = 3; // minimal push
      });

      // Touch events for mobile
      let touchStartX = 0;
      carousel.addEventListener('touchstart', (e: TouchEvent) => {
        dragging = true;
        paused = true;
        momentum = 0;
        touchStartX = e.touches[0].clientX;
        dragOffsetStart = offset;
      }, { passive: true });

      carousel.addEventListener('touchmove', (e: TouchEvent) => {
        if (!dragging) return;
        const delta = touchStartX - e.touches[0].clientX;
        offset = dragOffsetStart + delta;
      }, { passive: true });

      carousel.addEventListener('touchend', () => {
        dragging = false;
        paused = false;
      }, { passive: true });

      rafId = requestAnimationFrame(animate);

      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(rafId);
      }, { once: true });
    });
  }

  initReviewsMarquee();
  document.addEventListener('astro:page-load', initReviewsMarquee);
</script>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3rem;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.8);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-inner-card {
    border-radius: 2rem;
    background: #F8FAFC;
    box-shadow: 
      inset 8px 8px 16px rgba(28, 57, 142, 0.04),
      inset -8px -8px 16px rgba(255, 255, 255, 0.8);
  }

  .clay-star-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.1), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.2),
      0 4px 8px rgba(22, 163, 74, 0.3);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate] {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
