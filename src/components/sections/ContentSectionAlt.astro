---
import { getLocationText } from "@/config/brand-settings"
import { CheckCircle2, ArrowRight } from "lucide-react"

interface FeatureItem {
  icon?: string;
  title: string;
  description: string;
}

interface Props {
  badge?: string;
  title: string;
  titleHighlight?: string;
  description: string;
  featuresTitle?: string;
  features?: FeatureItem[];
  buttonText?: string;
  buttonHref?: string;
  imagePosition?: "left" | "right";
  image?: string;
  imageAlt?: string;
}

const { 
  badge: raw_badge, 
  title: raw_title, 
  titleHighlight,
  description: raw_description, 
  featuresTitle,
  features = [], 
  buttonText, 
  buttonHref,
  imagePosition = "left",
  image,
  imageAlt = "Section image"
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const titleHighlightProcessed = titleHighlight ? getLocationText(titleHighlight) : titleHighlight;
const description = raw_description ? getLocationText(raw_description) : raw_description;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;
---

<section class="py-16 md:py-20 bg-[#f8faff] relative overflow-hidden">
  
  {/* Fluid Background Accents */}
  <div class="absolute top-0 left-0 w-[400px] h-[400px] bg-[#3B82F6]/3 rounded-full blur-[80px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[400px] h-[400px] bg-[#16A34A]/3 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    
    {/* Header Section */}
    <div class="text-center mb-10 lg:mb-14 flex flex-col items-center" data-animate="fade-up">
      {badge && (
        <div class="inline-flex items-center gap-2.5 bg-white px-5 py-2 rounded-full shadow-clayInner mb-5 border-2 border-white">
           <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#3B82F6]" style="font-family: 'JetBrains Mono', monospace;">{badge}</span>
        </div>
      )}
      
      <h2 class="text-3xl md:text-4xl lg:text-5xl font-black text-[#1C398E] leading-[1.1] tracking-tight uppercase max-w-4xl" style="font-family: 'Poppins', sans-serif;">
        {title}{" "}
        {titleHighlightProcessed && (
           <span class="text-[#3B82F6]">{titleHighlightProcessed}</span>
        )}
      </h2>
      
      {description && (
        <p class="text-base text-[#1C398E]/60 mt-5 leading-relaxed font-medium max-w-2xl mx-auto" style="font-family: 'Montserrat', sans-serif;" set:html={description} />
      )}
    </div>

    {/* Content Chassis */}
    <div class="bg-white rounded-[40px] lg:rounded-[60px] shadow-clayCard p-6 lg:p-10 border border-white relative z-20">
      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-stretch">
        
        {/* Image Column */}
        <div class={`w-full relative flex flex-col min-h-[300px] lg:min-h-0 ${imagePosition === 'right' ? 'lg:order-2' : 'lg:order-1'}`} data-animate={imagePosition === 'right' ? 'fade-left' : 'fade-right'}>
          <div class="w-full flex-grow rounded-[32px] lg:rounded-[40px] bg-[#f8faff] p-3 shadow-clayInner border-4 border-white group relative flex flex-col">
            
            <div class="w-full flex-grow rounded-[20px] lg:rounded-[28px] overflow-hidden shadow-clayCard relative bg-white flex items-center justify-center">
              {image ? (
                <img src={image} alt={imageAlt} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-105 absolute inset-0" />
              ) : (
                <span class="text-[#1C398E]/20 font-black uppercase tracking-widest text-xs absolute inset-0 flex items-center justify-center">Visual Representation</span>
              )}
              
              {/* Soft inner overlay for clay feel */}
              <div class="absolute inset-0 shadow-[inset_0_0_30px_rgba(28,57,142,0.04)] pointer-events-none"></div>
            </div>
          </div>
        </div>

        {/* Features Column */}
        <div class={`flex flex-col justify-center space-y-6 ${imagePosition === 'right' ? 'lg:order-1' : 'lg:order-2'}`} data-animate={imagePosition === 'right' ? 'fade-right' : 'fade-left'}>
          {featuresTitle && (
            <h3 class="text-xl md:text-2xl font-black text-[#1C398E] uppercase tracking-tight pl-2" style="font-family: 'Poppins', sans-serif;">
              {featuresTitle}
            </h3>
          )}
          
          {features.length > 0 && (
            <div class="space-y-3 md:space-y-4">
              {features.map((feature, i) => (
                <div 
                  class="bg-[#f8faff] rounded-[24px] p-5 shadow-clayInner border-2 border-white flex gap-4 group hover:-translate-y-0.5 transition-all duration-300"
                  style={`animation-delay: ${i * 0.1}s`}
                >
                  <div class="flex-shrink-0 w-12 h-12 rounded-full bg-white shadow-clayCard border-2 border-[#f8faff] text-[#16A34A] flex items-center justify-center group-hover:scale-110 transition-transform duration-300">
                    {feature.icon ? (
                      <span class="text-base" set:html={feature.icon} />
                    ) : (
                      <CheckCircle2 className="w-6 h-6" strokeWidth={2.5} />
                    )}
                  </div>
                  <div class="flex flex-col justify-center">
                    <h4 class="font-black text-base md:text-lg text-[#1C398E] mb-0.5" style="font-family: 'Poppins', sans-serif;">{feature.title}</h4>
                    <p class="text-[13px] md:text-sm text-[#1C398E]/60 font-medium leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={feature.description} />
                  </div>
                </div>
              ))}
            </div>
          )}

          {buttonText && buttonHref && (
            <div class="pt-4 flex justify-start pl-2">
              <a href={buttonHref} class="clay-btn-primary h-14 px-8 text-[12px] md:text-[13px] text-white font-black uppercase tracking-widest inline-flex items-center justify-center group shadow-clayButton rounded-full">
                {buttonText}
                <ArrowRight className="w-4 h-4 ml-3 group-hover:translate-x-1.5 transition-transform" />
              </a>
            </div>
          )}
        </div>

      </div>
    </div>
  </div>
</section>
