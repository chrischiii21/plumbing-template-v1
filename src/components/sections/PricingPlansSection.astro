---
import { getLocationText } from "@/config/brand-settings"
import { Check } from "lucide-react"

interface Plan {
  ribbon: string;
  ribbonColor?: "great" | "better" | "best";
  title: string;
  price: string;
  period?: string;
  features: string[];
}

interface Props {
  title: string;
  description: string;
  plans: Plan[];
}

const { title: raw_title, description: raw_description, plans } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;

const ribbonColors = {
  great: "bg-[#F0F4F9] text-[#1C398E]/60",
  better: "bg-[#3B82F6]/10 text-[#3B82F6]",
  best: "bg-[#3B82F6] text-white shadow-[0_8px_20px_rgba(59,130,246,0.3)]"
};
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-0 right-0 w-[40%] h-[40%] bg-[#3B82F6]/5 rounded-full blur-[120px] pointer-events-none animate-pulse"></div>
  <div class="absolute bottom-0 left-0 w-[30%] h-[30%] bg-[#16A34A]/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto text-center mb-20 md:mb-24" data-animate="fade-up">
      <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] mb-8 leading-tight tracking-tighter">{title}</h2>
      <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />
    </div>
    
    <div class="grid md:grid-cols-3 gap-10 lg:gap-12 max-w-7xl mx-auto" data-animate-stagger>
      {plans.map((plan) => (
        <div class={`clay-card group relative flex flex-col h-full transition-all duration-500 will-change-transform transform-gpu hover:-translate-y-4 ${plan.ribbonColor === 'best' ? 'clay-card-featured' : ''}`}>
          
          {/* Ribbon Label */}
          <div class="absolute -top-4 left-1/2 -translate-x-1/2 z-20">
            <div class={`px-6 py-2 rounded-full clay-badge-ribbon text-[10px] font-mono font-bold uppercase tracking-[0.2em] whitespace-nowrap ${ribbonColors[plan.ribbonColor || "great"]}`}>
              {plan.ribbon}
            </div>
          </div>

          <div class="p-8 md:p-10 flex flex-col h-full relative z-10">
            <h3 class="clay-title text-2xl font-black text-[#1C398E] text-center mb-8 uppercase tracking-tight">{plan.title}</h3>
            
            {/* Price Puffy Area */}
            <div class="clay-inner-card p-8 rounded-[2.5rem] mb-10 text-center group-hover:bg-white transition-colors duration-500">
              <div class="flex items-center justify-center gap-1 mb-1">
                <span class="clay-title text-5xl font-black text-[#1C398E] tracking-tighter">{plan.price}</span>
              </div>
              {plan.period && <span class="clay-subtitle text-xs font-bold text-[#1C398E]/30 uppercase tracking-widest">{plan.period}</span>}
            </div>

            {/* Features List */}
            <ul class="space-y-5 mb-8 flex-grow">
              {plan.features.map((feature) => (
                <li class="flex items-start gap-4">
                  <div class={`w-6 h-6 rounded-full flex items-center justify-center shrink-0 mt-0.5 clay-star-badge ${plan.ribbonColor === 'best' ? 'bg-[#3B82F6] text-white' : 'bg-[#16A34A] text-white'}`}>
                    <Check className="w-3.5 h-3.5" strokeWidth={4} />
                  </div>
                  <span class="clay-subtitle text-sm font-semibold text-[#1C398E]/70 leading-relaxed">{feature}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Decorative Corner Element */}
          <div class={`absolute -bottom-12 -right-12 w-48 h-48 rounded-full blur-3xl transition-transform duration-1000 group-hover:scale-125 ${plan.ribbonColor === 'best' ? 'bg-[#3B82F6]/10' : 'bg-[#1C398E]/5'}`}></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3.5rem;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2.5px solid rgba(255, 255, 255, 0.8);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-card-featured {
    border-color: rgba(59, 130, 246, 0.2);
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      30px 60px 100px rgba(59, 130, 246, 0.12);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-badge-ribbon {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.2),
      0 10px 20px rgba(28, 57, 142, 0.1);
  }

  .clay-inner-card {
    background: #F8FAFC;
    box-shadow: 
      inset 10px 10px 20px rgba(28, 57, 142, 0.05),
      inset -10px -10px 20px rgba(255, 255, 255, 0.8);
  }

  .clay-star-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.1), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.2),
      0 4px 10px rgba(22, 163, 74, 0.3);
  }

  .clay-card-featured .clay-star-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.1), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.2),
      0 4px 10px rgba(59, 130, 246, 0.4);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate-stagger] > * {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
