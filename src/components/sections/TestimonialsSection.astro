---
import { getLocationText } from "@/config/brand-settings"
import { Quote, MessageSquare } from "lucide-react"

interface Testimonial {
  name: string;
  initials: string;
  date: string;
  rating: number;
  content: string;
}

interface Props {
  badge?: string;
  title: string;
  description?: string;
  testimonials: Testimonial[];
}

const { badge: raw_badge = "Testimonials", title: raw_title, description: raw_description, testimonials: rawTestimonials } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;
const testimonials = rawTestimonials.map(t => ({
  ...t,
  content: getLocationText(t.content),
}));
---

<section class="py-24 bg-[#f8faff] relative overflow-hidden border-y border-[#3B82F6]/5 shadow-clayInner">
  {/* Ambient Clay Blobs */}
  <div class="absolute top-0 -left-20 w-96 h-96 bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-[#16A34A]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16" data-animate="fade-up">
      <div class="inline-flex items-center gap-3 bg-white px-5 py-2.5 rounded-full shadow-clayButton mb-6">
        <MessageSquare className="w-5 h-5 text-[#3B82F6]" />
        <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#1C398E]" style="font-family: 'JetBrains Mono', monospace;">{badge}</span>
      </div>
      <h2 class="text-4xl md:text-5xl font-black text-[#1C398E] mb-6 tracking-tight leading-tight uppercase" style="font-family: 'Poppins', sans-serif;">{title}</h2>
      {description && <p class="text-[17px] text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={description} />}
    </div>

    <div class="testimonials-carousel overflow-hidden cursor-grab active:cursor-grabbing select-none" data-animate="fade-up">
      <div class="testimonials-marquee flex py-10" style="will-change: transform;">
        {/* Render cards twice for seamless loop */}
        {[...testimonials, ...testimonials].map((testimonial) => (
          <div class="flex-shrink-0 w-[320px] sm:w-[380px] px-5 group">
            <div class="bg-white rounded-[32px] p-8 shadow-clayCard group-hover:shadow-clayFloating group-hover:-translate-y-2 transition-all duration-500 h-full flex flex-col relative overflow-hidden">
              
              {/* Quote Icon Puffy Housing */}
              <div class="absolute -right-4 -top-4 w-20 h-20 bg-[#3B82F6]/5 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
              <div class="absolute top-6 right-8 text-[#3B82F6]/20 group-hover:text-[#3B82F6]/40 transition-colors">
                <Quote className="w-10 h-10" />
              </div>

              <div class="flex items-center gap-5 mb-8 relative z-10">
                <div class="w-16 h-16 rounded-full bg-white shadow-clayButton flex items-center justify-center border-4 border-white">
                  <span class="text-xl font-black text-[#3B82F6]" style="font-family: 'Poppins', sans-serif;">{testimonial.initials}</span>
                </div>
                <div>
                  <p class="font-black text-[#1C398E] text-lg uppercase tracking-tight" style="font-family: 'Poppins', sans-serif;">{testimonial.name}</p>
                  <p class="text-[10px] font-bold text-[#1C398E]/30 uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace;">{testimonial.date}</p>
                </div>
              </div>

              {/* Rating Puffy Labels */}
              <div class="flex gap-1.5 mb-6 relative z-10">
                {Array.from({ length: 5 }).map((_, i) => (
                  <div class={`w-6 h-6 rounded-full flex items-center justify-center shadow-clayButton ${i < testimonial.rating ? 'bg-[#16A34A] text-white' : 'bg-[#f8faff] text-[#1C398E]/10'}`}>
                    <svg class="w-3.5 h-3.5" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
                  </div>
                ))}
              </div>

              <div class="bg-[#f8faff] rounded-[24px] p-6 shadow-clayInner group-hover:shadow-clayButton transition-all duration-500 flex-1">
                <p class="text-[15px] text-[#1C398E]/70 font-medium leading-relaxed italic" style="font-family: 'Montserrat', sans-serif;" set:html={testimonial.content} />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  function initTestimonialsMarquee() {
    document.querySelectorAll<HTMLElement>('.testimonials-carousel').forEach((carousel) => {
      const marquee = carousel.querySelector<HTMLElement>('.testimonials-marquee');
      if (!marquee) return;

      if (marquee.dataset.init === 'true') return;
      marquee.dataset.init = 'true';

      let offset = 0;
      let speed = 0.6; // slightly faster for clay bounce feel
      let paused = false;
      let dragging = false;
      let dragStartX = 0;
      let dragOffsetStart = 0;
      let momentum = 0;
      let rafId: number;

      function getHalfWidth(): number {
        return marquee!.scrollWidth / 2;
      }

      function wrapOffset() {
        const half = getHalfWidth();
        if (half > 0) {
          offset = ((offset % half) + half) % half;
        }
      }

      function animate() {
        if (dragging) {
        } else if (momentum !== 0) {
          offset += momentum;
          momentum *= 0.95;
          if (Math.abs(momentum) < 0.1) momentum = 0;
        } else if (!paused) {
          offset += speed;
        }
        wrapOffset();
        marquee!.style.transform = `translateX(-${offset}px)`;
        rafId = requestAnimationFrame(animate);
      }

      carousel.addEventListener('mouseenter', () => { if (!dragging) paused = true; });
      carousel.addEventListener('mouseleave', () => { paused = false; dragging = false; });

      carousel.addEventListener('mousedown', (e: MouseEvent) => {
        dragging = true;
        paused = true;
        momentum = 0;
        dragStartX = e.clientX;
        dragOffsetStart = offset;
        e.preventDefault();
      });

      window.addEventListener('mousemove', (e: MouseEvent) => {
        if (!dragging) return;
        const delta = dragStartX - e.clientX;
        offset = dragOffsetStart + delta;
      });

      window.addEventListener('mouseup', () => {
        if (!dragging) return;
        dragging = false;
        momentum = offset - dragOffsetStart > 0 ? 3 : offset - dragOffsetStart < 0 ? -3 : 0;
      });

      let touchStartX = 0;
      carousel.addEventListener('touchstart', (e: TouchEvent) => {
        dragging = true;
        paused = true;
        momentum = 0;
        touchStartX = e.touches[0].clientX;
        dragOffsetStart = offset;
      }, { passive: true });

      carousel.addEventListener('touchmove', (e: TouchEvent) => {
        if (!dragging) return;
        const currentX = e.touches[0].clientX;
        const delta = touchStartX - currentX;
        offset = dragOffsetStart + delta;
      }, { passive: true });

      carousel.addEventListener('touchend', () => {
        if (!dragging) return;
        dragging = false;
        const totalDelta = offset - dragOffsetStart;
        momentum = totalDelta > 0 ? 3 : totalDelta < 0 ? -3 : 0;
        setTimeout(() => { paused = false; }, 2000);
      }, { passive: true });

      if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        paused = true;
      }

      rafId = requestAnimationFrame(animate);

      document.addEventListener('astro:before-swap', () => {
        cancelAnimationFrame(rafId);
      }, { once: true });
    });
  }

  initTestimonialsMarquee();
  document.addEventListener('astro:page-load', initTestimonialsMarquee);
</script>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.08),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8),
      inset -4px -4px 8px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayFloating {
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.12),
      -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.06),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6),
      inset -3px -3px 6px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 10px 10px 20px rgba(28, 57, 142, 0.06),
      inset -10px -10px 20px rgba(255, 255, 255, 1);
  }
</style>
