---
import { getLocationText } from "@/config/brand-settings"

interface Props {
  badge?: string;
  title: string;
  description: string;
  features?: string[];
  buttonText?: string;
  buttonHref?: string;
  imagePosition?: "left" | "right";
  images?: string[];
  imageAlts?: string[];
}

const { 
  badge: raw_badge, 
  title: raw_title, 
  description: raw_description, 
  features = [], 
  buttonText, 
  buttonHref,
  imagePosition = "left",
  images = [],
  imageAlts = []
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;
---

<section class="py-24 bg-white relative overflow-hidden">
  {/* Ambient Clay Blobs */}
  <div class="absolute top-1/2 -left-20 w-80 h-80 bg-[#3B82F6]/3 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute top-1/4 -right-20 w-80 h-80 bg-[#16A34A]/3 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class={`flex flex-col lg:flex-row items-center gap-16 lg:gap-24 ${imagePosition === "right" ? "lg:flex-row-reverse" : ""}`}>
      
      {/* Image Side - Clay Squircles */}
      <div class="lg:w-1/2" data-animate={imagePosition === "left" ? "fade-right" : "fade-left"}>
        <div class="grid grid-cols-2 gap-6 p-4 bg-[#f8faff] rounded-[60px] shadow-clayInner relative overflow-visible">
          {images.length > 0 ? (
            images.map((img, i) => (
              <div class={`aspect-square rounded-[40px] overflow-hidden shadow-clayCard transition-transform duration-700 hover:rotate-${i === 0 ? '-3' : '3'} hover:scale-105`}>
                <img 
                  src={img.includes('ucarecdn.com') ? img.replace(/\/preview\/\d+x\d+/, '/preview/480x480').concat('-/format/webp/') : img} 
                  alt={imageAlts[i] || `${title} - photo ${i + 1}`} 
                  class="w-full h-full object-cover" 
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="480"
                />
              </div>
            ))
          ) : (
            <>
              <div class="aspect-square bg-white rounded-[40px] shadow-clayCard flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-[#3B82F6]/10 animate-pulse"></div>
              </div>
              <div class="aspect-square bg-white rounded-[40px] shadow-clayCard flex items-center justify-center">
                <div class="w-12 h-12 rounded-full bg-[#16A34A]/10 animate-pulse" style="animation-delay: 1s;"></div>
              </div>
            </>
          )}

          {/* Decorative Floating Circle */}
          <div class="absolute -bottom-6 -right-6 w-20 h-20 bg-[#3B82F6] rounded-full shadow-clayCard animate-clay-float hidden lg:block"></div>
        </div>
      </div>

      {/* Content Side */}
      <div class="lg:w-1/2" data-animate="fade-up">
        {badge && (
          <div class="inline-flex items-center gap-3 bg-white px-5 py-2 rounded-full shadow-clayButton mb-8">
            <div class="w-2 h-2 rounded-full bg-[#3B82F6]"></div>
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#1C398E]" style="font-family: 'JetBrains Mono', monospace;">{badge}</span>
          </div>
        )}
        
        <h2 class="text-4xl md:text-5xl font-black text-[#1C398E] mb-8 leading-tight tracking-tight" style="font-family: 'Poppins', sans-serif;">
          {title}
        </h2>
        
        <p class="text-[17px] text-[#1C398E]/60 mb-10 leading-relaxed font-medium" style="font-family: 'Montserrat', sans-serif;" set:html={description} />
        
        {features.length > 0 && (
          <div class="grid sm:grid-cols-2 gap-4 mb-12">
            {features.map((feature) => (
              <div class="flex items-center gap-4 bg-white p-3 pr-6 rounded-[24px] shadow-clayButton hover:shadow-clayInner transition-all duration-300">
                <div class="w-8 h-8 shrink-0 rounded-full bg-[#16A34A] text-white flex items-center justify-center shadow-clayButton">
                  <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M5 13l4 4L19 7" /></svg>
                </div>
                <span class="text-xs font-black text-[#1C398E] uppercase tracking-wide leading-tight">{feature}</span>
              </div>
            ))}
          </div>
        )}

        {buttonText && buttonHref && (
          <a href={buttonHref} class="clay-btn-primary h-16 px-10 text-sm text-white font-black uppercase tracking-widest flex items-center justify-center">
            {buttonText}
          </a>
        )}
      </div>

    </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.1),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 10px rgba(255, 255, 255, 0.8),
      inset -4px -4px 10px rgba(28, 57, 142, 0.05);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.08),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6),
      inset -3px -3px 6px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 8px 8px 16px rgba(28, 57, 142, 0.08),
      inset -8px -8px 16px rgba(255, 255, 255, 1);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 20px;
    box-shadow: 
      10px 10px 20px rgba(59, 130, 246, 0.3),
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: inline-flex;
  }

  .clay-btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .clay-btn-primary:active {
    transform: scale(0.96);
    box-shadow: inset 6px 6px 12px rgba(0, 0, 0, 0.2);
  }

  @keyframes clay-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-15px); }
  }
  .animate-clay-float {
    animation: clay-float 5s ease-in-out infinite;
  }
</style>
