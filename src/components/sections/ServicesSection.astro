---
import { getLocationText } from "@/config/site"
import { ChevronRight } from "lucide-react"

interface Service {
  title: string;
  description: string;
  href?: string;
}

interface ServiceCategory {
  title: string;
  services: Service[];
}

interface Props {
  title: string;
  description: string;
  categories: ServiceCategory[];
}

const { title: raw_title, description: raw_description, categories } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
---

<section class="py-24 bg-white relative overflow-hidden">
  {/* Ambient Clay Blobs */}
  <div class="absolute top-0 -left-20 w-96 h-96 bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-[#16A34A]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-20" data-animate="fade-up">
      <h2 class="text-4xl md:text-5xl font-black text-[#1C398E] mb-6 tracking-tight leading-tight uppercase" style="font-family: 'Poppins', sans-serif;">{title}</h2>
      <p class="text-[17px] text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed px-4" style="font-family: 'Montserrat', sans-serif;" set:html={description} />
    </div>
    
    <div class="space-y-24">
      {categories.map((category) => (
        <div class="space-y-10" data-animate="fade-up">
          <div class="flex items-center justify-center gap-6">
            <div class="w-12 h-2 rounded-full bg-[#3B82F6]/10 shadow-clayInner"></div>
            <h3 class="text-2xl font-black text-[#1C398E] uppercase tracking-widest px-8 py-3 bg-white rounded-full shadow-clayButton" style="font-family: 'Poppins', sans-serif;">
              {category.title}
            </h3>
            <div class="w-12 h-2 rounded-full bg-[#3B82F6]/10 shadow-clayInner"></div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8 p-4 bg-[#f8faff] rounded-[48px] shadow-clayInner">
            {category.services.map((service) => (
              service.href ? (
                <a href={service.href} class="group bg-white rounded-[32px] p-8 shadow-clayCard hover:shadow-clayFloating hover:-translate-y-2 transition-all duration-500 flex flex-col relative overflow-hidden">
                  {/* Decorative Puffy Shape in background */}
                  <div class="absolute -right-4 -top-4 w-16 h-16 bg-[#3B82F6]/5 rounded-full blur-xl group-hover:scale-150 transition-transform"></div>
                  
                  <h4 class="text-lg font-black text-[#1C398E] mb-3 group-hover:text-[#3B82F6] transition-colors leading-tight" style="font-family: 'Poppins', sans-serif;">{service.title}</h4>
                  <p class="text-[14px] text-[#1C398E]/50 font-medium leading-relaxed mb-8" style="font-family: 'Montserrat', sans-serif;" set:html={service.description} />
                  
                  <div class="mt-auto flex items-center gap-2 text-[10px] font-black uppercase tracking-widest text-[#3B82F6]">
                    View Details
                    <div class="w-6 h-6 rounded-full bg-white shadow-clayButton flex items-center justify-center group-hover:bg-[#3B82F6] group-hover:text-white transition-all">
                      <ChevronRight className="w-3.5 h-3.5" />
                    </div>
                  </div>
                </a>
              ) : (
                <div class="bg-white rounded-[32px] p-8 shadow-clayCard flex flex-col">
                  <h4 class="text-lg font-black text-[#1C398E] mb-3" style="font-family: 'Poppins', sans-serif;">{service.title}</h4>
                  <p class="text-[14px] text-[#1C398E]/50 font-medium leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={service.description} />
                </div>
              )
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.08),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 10px rgba(255, 255, 255, 0.8),
      inset -4px -4px 10px rgba(28, 57, 142, 0.03);
  }

  .shadow-clayFloating {
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.12),
      -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.06),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6),
      inset -3px -3px 6px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.06),
      inset -12px -12px 24px rgba(255, 255, 255, 1);
  }
</style>
