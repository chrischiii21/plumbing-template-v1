---
import { getLocationText } from "@/config/brand-settings"
import { ChevronRight } from "lucide-react"

interface Service {
  title: string;
  description: string;
  icon?: string;
  href?: string;
}

interface ServiceCategory {
  title: string;
  services: Service[];
}

interface Props {
  title: string;
  description: string;
  categories: ServiceCategory[];
}

const { title: raw_title, description: raw_description, categories } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Clay Blobs */}
  <div class="absolute top-0 -left-20 w-[40%] h-[40%] bg-[#3B82F6]/5 rounded-full blur-[120px] pointer-events-none animate-pulse"></div>
  <div class="absolute bottom-0 -right-20 w-[40%] h-[40%] bg-[#16A34A]/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-24 md:mb-32" data-animate="fade-up">
      <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] mb-8 leading-tight tracking-tighter uppercase">{title}</h2>
      <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />
    </div>
    
    <div class="space-y-32">
      {categories.map((category) => (
        <div class="space-y-12" data-animate="fade-up">
          <div class="flex items-center gap-8 px-4">
            <div class="h-px flex-grow bg-gradient-to-r from-transparent via-[#1C398E]/10 to-transparent"></div>
            <h3 class="clay-title text-2xl md:text-3xl font-black text-[#1C398E] uppercase tracking-tight px-10 py-4 bg-white rounded-full clay-badge">
              {category.title}
            </h3>
            <div class="h-px flex-grow bg-gradient-to-r from-transparent via-[#1C398E]/10 to-transparent"></div>
          </div>

          <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-10 p-10 bg-[#f8faff] rounded-[4rem] clay-inner-groove">
            {category.services.map((service) => (
              <div class="group relative bg-white rounded-[3rem] p-10 clay-card hover:-translate-y-3 transition-all duration-500 will-change-transform transform-gpu flex flex-col h-full overflow-hidden">
                
                {/* Decorative background accent */}
                <div class="absolute -right-6 -top-6 w-32 h-32 bg-[#3B82F6]/5 rounded-full blur-3xl group-hover:scale-150 transition-transform duration-1000"></div>

                {/* Icon Puffy Frame */}
                {service.icon && (
                  <div class="w-16 h-16 rounded-2xl bg-[#F8FAFC] clay-inner-groove p-3.5 mb-8 flex items-center justify-center group-hover:bg-white group-hover:shadow-clayFloating transition-all duration-500">
                    <div 
                      class="w-full h-full bg-[#3B82F6] group-hover:scale-110 transition-transform duration-500 drop-shadow-sm"
                      style={`-webkit-mask-image: url('${service.icon}'); -webkit-mask-size: contain; -webkit-mask-repeat: no-repeat; -webkit-mask-position: center; mask-image: url('${service.icon}'); mask-size: contain; mask-repeat: no-repeat; mask-position: center;`}
                    ></div>
                  </div>
                )}

                <h4 class="clay-title text-xl font-black text-[#1C398E] mb-4 leading-tight group-hover:text-[#3B82F6] transition-colors">{service.title}</h4>
                <p class="clay-subtitle text-[15px] text-[#1C398E]/50 font-medium leading-relaxed" set:html={service.description} />
                
                {service.href && (
                  <a href={service.href} class="mt-8 inline-flex items-center justify-center w-10 h-10 rounded-full bg-white clay-badge group/link hover:bg-[#3B82F6] hover:text-white transition-all duration-300">
                    <ChevronRight className="w-5 h-5" strokeWidth={3} />
                  </a>
                )}
              </div>
            ))}
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.8);
  }

  .shadow-clayFloating {
    box-shadow: 
      inset -4px -4px 8px rgba(0, 0, 0, 0.02), 
      inset 4px 4px 8px rgba(255, 255, 255, 0.9),
      10px 20px 40px rgba(28, 57, 142, 0.1);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-inner-groove {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.05),
      inset -12px -12px 24px rgba(255, 255, 255, 0.8);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate] {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
