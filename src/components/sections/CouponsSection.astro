---
import { Flame, Scissors, Clock } from 'lucide-react';
import { getLocationText } from "@/config/site"

interface Coupon {
  label: string;
  discount: string;
  description: string;
  expires: string;
}

interface Props {
  coupons: Coupon[];
  variant?: 'default' | 'minimal';
}

const { coupons, variant = 'default' } = Astro.props;
const isMinimal = variant === 'minimal';
---

<section class="py-24 bg-[#f8faff] relative overflow-hidden border-y border-[#3B82F6]/10 shadow-clayInner">
  {/* Ambient Blobs */}
  <div class="absolute top-0 -left-20 w-96 h-96 bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-[#16A34A]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16" data-animate="fade-up">
      {!isMinimal && (
        <span class="inline-flex items-center gap-3 bg-white text-[#1C398E] text-[10px] font-black px-6 py-2.5 rounded-full mb-6 shadow-clayButton uppercase tracking-[0.2em]" style="font-family: 'JetBrains Mono', monospace;">
          <Flame className="w-4 h-4 text-[#D97706]" />
          Limited Time Offers
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-black text-[#1C398E] tracking-tight leading-tight" style="font-family: 'Poppins', sans-serif;">
        {isMinimal ? 'Special Discounts & Promotions' : 'Save Big on Plumbing Services'}
      </h2>
      {isMinimal && (
        <p class="text-[15px] text-[#1C398E]/60 mt-4 max-w-2xl mx-auto font-medium" style="font-family: 'Montserrat', sans-serif;">
          Check this page regularly for the latest special offers and promotions from {getLocationText("{fullName}")}. We also offer financing.
        </p>
      )}
    </div>

    <div class={isMinimal ? 'grid sm:grid-cols-2 lg:grid-cols-3 gap-6' : 'grid md:grid-cols-2 lg:grid-cols-3 gap-8'}>
      {coupons.map((coupon) => (
        <div class="coupon-card group relative bg-white rounded-[40px] p-8 text-center shadow-clayCard transition-all duration-500 hover:-translate-y-2 hover:shadow-clayFloating overflow-visible">
          
          {/* Scissors Icon Puffy Label */}
          <div class="absolute -left-3 -top-3 w-12 h-12 bg-white rounded-full flex items-center justify-center shadow-clayButton text-[#3B82F6] z-20 group-hover:scale-110 transition-transform">
            <Scissors className="w-6 h-6" />
          </div>

          <div class="relative z-10">
            <span class="inline-block bg-[#3B82F6]/5 text-[#3B82F6] text-[10px] font-black px-4 py-1.5 rounded-full uppercase tracking-widest mb-4 shadow-clayInner" style="font-family: 'JetBrains Mono', monospace;">
              {coupon.label}
            </span>
            
            <h3 class="text-sm font-black text-[#1C398E] uppercase tracking-widest mb-1 opacity-40" style="font-family: 'Poppins', sans-serif;">Special Deal</h3>
            <p class="text-[11px] text-[#1C398E]/30 font-bold uppercase tracking-widest mb-6">Redeem & Save Today</p>
            
            {/* Discount Display - Puffy Well */}
            <div class="bg-[#f8faff] rounded-[32px] py-8 mb-6 shadow-clayInner group-hover:shadow-clayButton transition-all duration-500">
              <div class="text-5xl md:text-6xl font-black text-[#3B82F6] tracking-tighter" style="font-family: 'Poppins', sans-serif;">
                {coupon.discount}
              </div>
            </div>

            <p class="text-[15px] text-[#1C398E]/60 font-medium mb-8 leading-relaxed px-4" style="font-family: 'Montserrat', sans-serif;" set:html={coupon.description} />
            
            <div class="pt-6 border-t border-[#3B82F6]/5 flex flex-col items-center gap-4">
              <div class="flex items-center gap-2 text-[10px] text-[#1C398E]/40 font-bold uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace;">
                <Clock className="w-3 h-3 text-[#16A34A]" />
                Expires: {coupon.expires}
              </div>
              
              <a href="/contact" class="clay-btn-primary w-full py-4 text-white font-black text-[11px] uppercase tracking-[0.2em] shadow-clayButton">
                Claim Now
              </a>
            </div>
          </div>

          {/* Dashed Cut Line Decoration */}
          <div class="absolute left-0 right-0 top-1/2 border-t-2 border-dashed border-[#3B82F6]/5 -translate-y-1/2 pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity"></div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Clay Foundation Styles */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.1),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8),
      inset -4px -4px 8px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayFloating {
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.15),
      -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.08),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 2px 2px 4px rgba(255, 255, 255, 0.6),
      inset -2px -2px 4px rgba(28, 57, 142, 0.03);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.08),
      inset -6px -6px 12px rgba(255, 255, 255, 1);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 20px;
    box-shadow: 
      8px 8px 16px rgba(59, 130, 246, 0.3),
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .clay-btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .clay-btn-primary:active {
    transform: scale(0.96);
    box-shadow: inset 6px 6px 12px rgba(0, 0, 0, 0.2);
  }
</style>
