---
import { Flame, Scissors, Clock } from 'lucide-react';
import { getLocationText } from "@/config/brand-settings"

interface Coupon {
  label: string;
  discount: string;
  description: string;
  expires: string;
}

interface Props {
  coupons: Coupon[];
  variant?: 'default' | 'minimal';
}

const { coupons, variant = 'default' } = Astro.props;
const isMinimal = variant === 'minimal';
---

<section class="py-24 bg-[#f8faff] relative overflow-hidden border-y border-[#3B82F6]/10 shadow-clayInner">
  {/* Ambient Blobs */}
  <div class="absolute top-0 -left-20 w-96 h-96 bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-20 w-96 h-96 bg-[#16A34A]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16" data-animate="fade-up">
      {!isMinimal && (
        <span class="inline-flex items-center gap-3 bg-white text-[#1C398E] text-[10px] font-black px-6 py-2.5 rounded-full mb-6 shadow-clayButton uppercase tracking-[0.2em]" style="font-family: 'JetBrains Mono', monospace;">
          <Flame className="w-4 h-4 text-[#D97706]" />
          Limited Time Offers
        </span>
      )}
      <h2 class="text-4xl md:text-5xl font-black text-[#1C398E] tracking-tight leading-tight" style="font-family: 'Poppins', sans-serif;">
        {isMinimal ? 'Special Discounts & Promotions' : 'Save Big on Plumbing Services'}
      </h2>
      {isMinimal && (
        <p class="text-[15px] text-[#1C398E]/60 mt-4 max-w-2xl mx-auto font-medium" style="font-family: 'Montserrat', sans-serif;">
          Check this page regularly for the latest special offers and promotions from {getLocationText("{fullName}")}. We also offer financing.
        </p>
      )}
    </div>

    <div class={isMinimal ? 'grid sm:grid-cols-2 lg:grid-cols-3 gap-6' : 'grid md:grid-cols-2 lg:grid-cols-3 gap-8'}>
      {coupons.map((coupon) => (
        <div class="coupon-card group bg-white rounded-[32px] text-center shadow-clayCard transition-all duration-500 hover:-translate-y-2 hover:shadow-clayFloating flex flex-col h-full overflow-hidden border border-white/50 relative">
          
          {/* Scissors Icon */}
          <div class="absolute left-4 top-4 w-10 h-10 bg-white/90 backdrop-blur-sm rounded-full flex items-center justify-center shadow-clayButton text-[#3B82F6] z-20 group-hover:rotate-12 transition-transform">
            <Scissors className="w-5 h-5" />
          </div>
          
          {/* Ticket Header - The Discount Offer */}
          <div class="bg-[#3B82F6] px-8 py-10 relative overflow-hidden shadow-clayButton">
            <div class="absolute inset-0 bg-gradient-to-br from-white/20 via-transparent to-black/10 pointer-events-none"></div>
            
            {/* SAVE Corner Ribbon */}
            <div class="absolute top-0 right-0 overflow-hidden w-24 h-24 z-30">
              <div class="absolute top-0 right-0 transform translate-x-[30%] translate-y-[40%] rotate-45 w-[140%] py-1.5 bg-[#DC2626] text-center text-[11px] font-black text-white uppercase tracking-[0.2em] shadow-lg">
                Save
              </div>
            </div>

            {/* Missing Hardcoded Texts from Reference */}
            <h3 class="text-xs md:text-sm font-black text-white uppercase tracking-[0.2em] mb-1 opacity-90 relative z-10" style="font-family: 'Poppins', sans-serif;">Special Deal</h3>
            <p class="text-[9px] md:text-[10px] text-white/60 font-bold uppercase tracking-[0.3em] mb-4 relative z-10">Redeem & Save Today</p>

            {/* The Discount */}
            <div class="text-5xl md:text-6xl font-black text-white tracking-tighter drop-shadow-lg relative z-10 group-hover:scale-110 transition-transform duration-700" style="font-family: 'Poppins', sans-serif;">
              {coupon.discount}
            </div>

            {/* Dashed cut line */}
            <div class="absolute bottom-0 left-0 right-0 border-b-[4px] border-dashed border-white/30"></div>
          </div>

          {/* Ticket Body - The Details */}
          <div class="p-8 flex flex-col flex-grow relative bg-white">
            {/* Cut out circles for ticket effect */}
            <div class="absolute -left-6 -top-6 w-12 h-12 bg-[#f8faff] rounded-full shadow-inner pointer-events-none"></div>
            <div class="absolute -right-6 -top-6 w-12 h-12 bg-[#f8faff] rounded-full shadow-inner pointer-events-none"></div>

            {/* The Offer Label / Subject */}
            <h3 class="text-2xl md:text-3xl font-black text-[#1C398E] mb-4 uppercase tracking-tight leading-tight mt-2" style="font-family: 'Poppins', sans-serif;">
              {coupon.label}
            </h3>

            {/* The Description */}
            <p class="coupon-desc text-[15px] text-[#1C398E]/70 font-medium mb-8 flex-grow leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={coupon.description} />

            {/* Expiry Date */}
            <div class="pt-6 border-t border-[#3B82F6]/10 flex justify-center mt-auto">
              <div class="flex items-center gap-2 text-[#DC2626] text-[10px] font-black uppercase tracking-[0.2em] bg-[#DC2626]/5 rounded-full px-5 py-2.5 shadow-sm transition-colors group-hover:bg-[#DC2626]/10" style="font-family: 'JetBrains Mono', monospace;">
                <Clock className="w-3.5 h-3.5" strokeWidth={2.5} />
                Expires: {coupon.expires}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  /* Clay Foundation Styles */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.1),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8),
      inset -4px -4px 8px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayFloating {
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.15),
      -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.08),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 2px 2px 4px rgba(255, 255, 255, 0.6),
      inset -2px -2px 4px rgba(28, 57, 142, 0.03);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.08),
      inset -6px -6px 12px rgba(255, 255, 255, 1);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 20px;
    box-shadow: 
      8px 8px 16px rgba(59, 130, 246, 0.3),
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    display: inline-flex;
    align-items: center;
    justify-content: center;
  }

  .clay-btn-primary:hover {
    transform: translateY(-2px);
    filter: brightness(1.05);
  }

  .clay-btn-primary:active {
    transform: scale(0.96);
    box-shadow: inset 6px 6px 12px rgba(0, 0, 0, 0.2);
  }


</style>
