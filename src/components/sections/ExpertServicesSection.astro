---
import { getLocationText } from "@/config/brand-settings"

interface FeatureBox {
  icon: string;
  title: string;
  description: string;
}

interface Props {
  title: string;
  highlightedText?: string;
  description: string;
  image: string;
  imageAlt?: string;
  features: FeatureBox[];
}

const { 
  title: raw_title, 
  highlightedText,
  description: raw_description, 
  image,
  imageAlt = "Service image",
  features
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;

const iconMap: Record<string, string> = {
  wrench: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>`,
  users: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>`,
  dollar: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" x2="12" y1="2" y2="22"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg>`,
  settings: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>`,
  heart: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>`,
  shield: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 13c0 5-3.5 7.5-7.66 8.95a1 1 0 0 1-.67-.01C7.5 20.5 4 18 4 13V6a1 1 0 0 1 1-1c2 0 4.5-1.2 6.24-2.72a1.17 1.17 0 0 1 1.52 0C14.51 3.81 17 5 19 5a1 1 0 0 1 1 1z"/><path d="m9 12 2 2 4-4"/></svg>`,
  zap: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 14a1 1 0 0 1-.78-1.63l9.9-10.2a.5.5 0 0 1 .86.46l-1.92 6.02A1 1 0 0 0 13 10h7a1 1 0 0 1 .78 1.63l-9.9 10.2a.5.5 0 0 1-.86-.46l1.92-6.02A1 1 0 0 0 11 14z"/></svg>`
};
---

<section class="py-16 md:py-24 bg-[#f8faff] relative overflow-hidden border-y border-[#3B82F6]/5 shadow-clayInner">
  {/* Ambient Clay Blobs */}
  <div class="absolute -top-20 -left-20 w-[400px] h-[400px] bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none"></div>
  <div class="absolute bottom-0 -right-20 w-[400px] h-[400px] bg-[#16A34A]/5 rounded-full blur-3xl pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="grid md:grid-cols-2 gap-12 items-start">
      
      <!-- Image with Claymorphism Frame -->
      <div class="relative group" data-animate="fade-right">
        {/* Glow behind the card */}
        <div class="absolute -inset-4 bg-[#3B82F6]/10 rounded-[28px] blur-xl group-hover:bg-[#3B82F6]/15 transition-colors duration-700 pointer-events-none"></div>
        
        <div class="relative bg-white rounded-[24px] p-3 shadow-clayCard transition-all duration-700 group-hover:shadow-clayFloating group-hover:-translate-y-2 border border-white">
          <div class="rounded-[16px] overflow-hidden shadow-clayInner max-h-[350px] relative">
            <img src={image} alt={imageAlt} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-1000" />
            <div class="absolute inset-0 bg-gradient-to-t from-[#1C398E]/20 to-transparent mix-blend-multiply opacity-50 pointer-events-none"></div>
          </div>
        </div>
      </div>

      <!-- Content -->
      <div data-animate="fade-left">
        <h2 class="text-3xl md:text-4xl font-bold text-[#1C398E] mb-4" style="font-family: 'Poppins', sans-serif;">
          {title}
          {highlightedText && (
            <span class="text-[#3B82F6] relative inline-block ml-1">
              <span class="relative z-10">{highlightedText}</span>
              <span class="absolute bottom-1 left-0 w-full h-2 bg-[#3B82F6]/20 -z-10 rounded-full"></span>
            </span>
          )}
        </h2>
        
        <p class="text-[#1C398E]/80 mb-8 leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={`At <span class="font-bold text-[#1C398E]">${getLocationText("{fullName}")}</span>, ${description}`} />

        <!-- Feature boxes grid -->
        <div class="grid grid-cols-2 gap-4">
          {features.map((feature) => (
            <div class="bg-white rounded-[20px] p-4 shadow-clayCard group hover:shadow-clayFloating hover:-translate-y-1 transition-all duration-500 relative overflow-hidden border border-white flex gap-3 items-start">
              <div class="absolute -right-4 -top-4 w-16 h-16 bg-[#3B82F6]/5 rounded-full blur-xl group-hover:scale-150 transition-transform duration-700"></div>
              
              <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#f8faff] shadow-clayInner flex items-center justify-center text-[#3B82F6] border-2 border-white group-hover:scale-110 group-hover:bg-white group-hover:shadow-clayButton transition-all duration-500 relative z-10">
                <Fragment set:html={iconMap[feature.icon] || iconMap.wrench} />
              </div>
              
              <div class="relative z-10">
                <h4 class="font-bold text-[#1C398E] text-[14px] mb-1" style="font-family: 'Poppins', sans-serif;">{feature.title}</h4>
                <p class="text-[#1C398E]/60 text-[12px] font-medium mt-1 leading-relaxed" style="font-family: 'Montserrat', sans-serif;" set:html={feature.description} />
              </div>
            </div>
          ))}
        </div>
      </div>
      
    </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      12px 12px 24px rgba(28, 57, 142, 0.08),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8),
      inset -4px -4px 8px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayFloating {
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.12),
      -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.06),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6),
      inset -3px -3px 6px rgba(28, 57, 142, 0.02);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 10px 10px 20px rgba(28, 57, 142, 0.06),
      inset -10px -10px 20px rgba(255, 255, 255, 1);
  }
</style>
