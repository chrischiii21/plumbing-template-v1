---
import { getLocationText } from "@/config/brand-settings"
import { Check } from "lucide-react"

interface Props {
  title: string;
  description: string;
  subtitle?: string;
  benefits?: string[];
}

const { title: raw_title, description: raw_description, subtitle: raw_subtitle, benefits = [] } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;
const subtitle = raw_subtitle ? getLocationText(raw_subtitle) : raw_subtitle;
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-16 md:py-24 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-0 left-0 w-[40%] h-[40%] bg-[#3B82F6]/5 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[30%] h-[30%] bg-[#16A34A]/5 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-5xl mx-auto">
      <!-- Header Area -->
      <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
        <h2 class="clay-title text-3xl md:text-5xl font-black text-[#1C398E] mb-8 leading-tight tracking-tighter">{title}</h2>
        <p class="clay-subtitle text-lg text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />
      </div>
      
      {/* Benefit Card */}
      {subtitle && benefits.length > 0 && (
        <div class="clay-card p-10 md:p-14 relative overflow-hidden group transform-gpu" data-animate="fade-up">
          <div class="relative z-10">
            <div class="flex items-center justify-center gap-4 mb-10">
              <h3 class="clay-title text-2xl font-black text-[#1C398E] uppercase tracking-tight">{subtitle}</h3>
            </div>
            
            <ul class="grid sm:grid-cols-2 gap-6 lg:gap-8">
              {benefits.map((benefit) => (
                <li class="clay-inner-item p-5 rounded-[2rem] flex items-start gap-4 hover:bg-white transition-colors duration-500">
                  <div class="w-7 h-7 rounded-full bg-[#16A34A] text-white flex items-center justify-center clay-star-badge shrink-0 mt-0.5">
                    <Check className="w-4 h-4" strokeWidth={4} />
                  </div>
                  <span class="clay-subtitle text-sm font-bold text-[#1C398E]/70 leading-snug">{benefit}</span>
                </li>
              ))}
            </ul>
          </div>

          {/* Background Micro-Accent */}
          <div class="absolute -bottom-10 -right-10 w-40 h-40 bg-[#3B82F6]/5 rounded-full blur-3xl"></div>
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3.5rem;
    box-shadow: 
      inset -12px -12px 24px rgba(0, 0, 0, 0.02), 
      inset 12px 12px 24px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  .clay-inner-item {
    background: #F8FAFC;
    box-shadow: 
      inset 8px 8px 16px rgba(28, 57, 142, 0.04),
      inset -8px -8px 16px rgba(255, 255, 255, 0.8);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-star-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.1), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.2),
      0 4px 10px rgba(22, 163, 74, 0.3);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate] {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
