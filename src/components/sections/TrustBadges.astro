---
interface Badge {
  name: string;
  image: string;
  alt?: string;
  small?: boolean;
}

interface Props {
  badges?: Badge[];
}

const { badges = [
  { name: "BBB & Angie's List", image: "/images/trust-badges/BBB_Angies-List.webp" },
  { name: "Google Reviews", image: "/images/trust-badges/google-review.webp" },
  { name: "Nextdoor", image: "/images/trust-badges/Nextdoor-logo.webp", small: true },
  { name: "HomeAdvisor", image: "/images/trust-badges/HomeAdvisor.webp" },
  { name: "BBB A+", image: "/images/trust-badges/bbb-logo-a-plus.webp" },
  { name: "Google Reviews 2", image: "/images/trust-badges/google-review.webp" },
] } = Astro.props;

// Triple the badges for extra smooth seamless loop
const duplicatedBadges = [...badges, ...badges, ...badges];
---

<section class="py-12 bg-[#f8faff] overflow-hidden border-y border-[#3B82F6]/10 shadow-clayInner">
  <div class="carousel-container">
    <div class="carousel-track py-6">
      {duplicatedBadges.map((badge) => (
        <div class="carousel-item px-8 group">
          {/* Puffy Clay Badge Squircle */}
          <div class="bg-white rounded-[24px] p-5 w-[160px] h-[90px] flex items-center justify-center shadow-clayButton group-hover:shadow-clayPressed group-hover:scale-105 transition-all duration-500">
            <img 
              src={badge.image} 
              alt={badge.alt || badge.name}
              class:list={[
                "grayscale opacity-40 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-500 object-contain",
                badge.small ? 'h-8' : 'h-10'
              ]}
              loading="lazy"
              decoding="async"
              width="160"
              height="90"
            />
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .carousel-container {
    width: 100%;
    overflow: hidden;
    mask-image: linear-gradient(to right, transparent, black 15%, black 85%, transparent);
  }

  .carousel-track {
    display: flex;
    align-items: center;
    width: max-content;
    animation: scroll 40s linear infinite;
    will-change: transform;
  }

  .carousel-item {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* Clay Foundation Styles */
  .shadow-clayButton {
    box-shadow: 
      8px 8px 16px rgba(28, 57, 142, 0.08),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.6),
      inset -4px -4px 8px rgba(28, 57, 142, 0.03);
  }

  .shadow-clayPressed {
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.08),
      inset -6px -6px 12px rgba(255, 255, 255, 1);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.05),
      inset -12px -12px 24px rgba(255, 255, 255, 0.5);
  }

  @keyframes scroll {
    0% { transform: translate3d(0, 0, 0); }
    100% { transform: translate3d(calc(-100% / 3), 0, 0); }
  }

  @media (prefers-reduced-motion: reduce) {
    .carousel-track { animation: none; }
  }
</style>
