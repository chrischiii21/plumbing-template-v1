---
import { getLocationText } from "@/config/brand-settings"

import { Percent, CircleDollarSign, Calendar, CheckCircle, Home, Building2, Wrench, Settings, ArrowRight, MapPin, Clock } from "lucide-react"

interface Item {
  title: string;
  text?: string;
  href?: string;
  icon?: string;
  image?: string;
}

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  items: Item[];
  variant?: "plans" | "services" | "features";
}

const { badge: raw_badge, title: raw_title, subtitle: raw_subtitle, items, variant = "plans" } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const subtitle = raw_subtitle ? getLocationText(raw_subtitle) : raw_subtitle;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;

const iconMap = {
  "percent": Percent,
  "zero": CircleDollarSign,
  "calendar": Calendar,
  "check": CheckCircle,
  "home": Home,
  "building": Building2,
  "wrench": Wrench,
  "settings": Settings,
  "map": MapPin,
  "clock": Clock
};

const defaultIcon = variant === "services" ? Wrench : CheckCircle;
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

{variant === "features" ? (
  <section class="py-20 md:py-32 bg-[#F0F4F9]/50 overflow-hidden relative">
    <div class="absolute top-0 right-0 w-64 h-64 bg-blue-100/30 rounded-full blur-[80px] pointer-events-none"></div>
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
        {badge && (
          <div class="inline-block px-4 py-1 rounded-full clay-badge mb-6">
            <span class="text-[0.65rem] font-mono font-bold tracking-widest text-[#3B82F6] uppercase">{badge}</span>
          </div>
        )}
        <h2 class="clay-title text-4xl md:text-5xl font-black text-[#1C398E] mb-6">{title}</h2>
        <div class="w-20 h-2 bg-[#3B82F6] mx-auto mb-8 rounded-full shadow-lg"></div>
        {subtitle && <p class="clay-subtitle text-lg text-[#1C398E]/60 max-w-3xl mx-auto font-medium" set:html={subtitle} />}
      </div>
      
      <div class="grid md:grid-cols-3 gap-8 lg:gap-12 max-w-6xl mx-auto" data-animate-stagger>
        {items.map((item) => {
          const IconComponent = iconMap[item.icon as keyof typeof iconMap] || CheckCircle;
          return (
            <div class="clay-card text-center group will-change-transform">
              <div class="w-20 h-20 rounded-full bg-[#3B82F6]/5 flex items-center justify-center mx-auto mb-8 clay-badge group-hover:scale-110 transition-transform duration-500">
                <IconComponent className="w-10 h-10 text-[#3B82F6]" />
              </div>
              <h3 class="clay-title text-2xl font-black text-[#1C398E] mb-4">{item.title}</h3>
              {item.text && <p class="clay-subtitle text-[#1C398E]/50 font-medium leading-relaxed" set:html={item.text} />}
            </div>
          );
        })}
      </div>
    </div>
  </section>
) : variant === "services" ? (
  <section class="py-20 md:py-32 bg-[#F8FAFC]">
    <div class="container mx-auto px-4">
      <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
        <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] tracking-tighter leading-tight">{title}</h2>
        <div class="w-24 h-2 bg-[#3B82F6] mx-auto mt-8 rounded-full shadow-lg"></div>
        {subtitle && <p class="clay-subtitle text-lg text-[#1C398E]/60 max-w-3xl mx-auto mt-8 font-medium leading-relaxed" set:html={subtitle} />}
      </div>
      
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 max-w-8xl mx-auto" data-animate-stagger>
        {items.map((item) => {
          return (
            <div class="clay-card-compact group will-change-transform hover:-translate-y-2 transition-all duration-500 overflow-hidden">
              {item.image && (
                <div class="relative w-full h-56 bg-[#f0f4f9] flex items-center justify-center overflow-hidden rounded-[2.5rem] mb-6 shadow-inner-clay">
                  <img src={item.image} alt={item.title} class="w-full h-full object-cover transition-transform duration-1000 group-hover:scale-110" />
                </div>
              )}
              <div class="px-2 text-center transform-gpu">
                <h3 class="clay-title text-xl font-black text-[#1C398E] mb-3 leading-tight">{item.title}</h3>
                {item.text && <p class="clay-subtitle text-sm text-[#1C398E]/50 font-medium leading-relaxed" set:html={item.text} />}
              </div>
            </div>
          );
        })}
      </div>
    </div>
  </section>
) : (
  <section class="py-20 md:py-32 bg-white relative">
    <div class="container mx-auto px-4 relative z-10">
      <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
        <h2 class="clay-title text-4xl md:text-5xl font-black text-[#1C398E] mb-6">{title}</h2>
        <div class="w-20 h-2 bg-[#3B82F6] mx-auto mb-8 rounded-full shadow-lg"></div>
        {subtitle && <p class="clay-subtitle text-lg text-[#1C398E]/60 max-w-3xl mx-auto font-medium" set:html={subtitle} />}
      </div>
      
      <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-8 lg:gap-10 max-w-7xl mx-auto" data-animate-stagger>
        {items.map((item) => {
          const IconComponent = iconMap[item.icon as keyof typeof iconMap] || defaultIcon;
          return (
            <div class="clay-card group text-center will-change-transform transition-all duration-500 hover:-translate-y-2">
              <div class="w-20 h-20 mx-auto mb-8 rounded-full bg-[#3B82F6]/5 flex items-center justify-center clay-badge group-hover:scale-110 transition-transform">
                <IconComponent className="w-10 h-10 text-[#3B82F6]" />
              </div>
              <h3 class="clay-title text-2xl font-black text-[#1C398E] mb-4 leading-tight">{item.title}</h3>
              {item.text && <p class="clay-subtitle text-sm text-[#1C398E]/50 font-medium leading-relaxed" set:html={item.text} />}
            </div>
          );
        })}
      </div>
    </div>
  </section>
)}

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3.5rem;
    padding: 3.5rem 2.5rem;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.8);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-card-compact {
    background: #ffffff;
    border-radius: 3.5rem;
    padding: 2.5rem;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.8);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .shadow-inner-clay {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.08),
      inset -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate-stagger] > * {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
