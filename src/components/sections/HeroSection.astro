---
import { getLocationText } from "@/config/brand-settings"

interface HeroSlide {
  title: string;
  subtitle?: string;
  image: string;
  promoTitle?: string;
  promoText?: string;
  promoImage?: string;
  buttonText?: string;
}

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  image?: string;
  slides?: HeroSlide[];
  variant?: "default" | "subpage" | "category";
  trustIndicators?: string[];
}

const {
  badge: rawBadge,
  title: rawTitle,
  subtitle: rawSubtitle,
  buttonText: rawButtonText = "Call Now",
  buttonHref: rawButtonHref = "tel:{phoneRaw}",
  image: rawImage,
  slides: rawSlides = [],
  variant = "default",
} = Astro.props;

const title = rawTitle ? getLocationText(rawTitle) : "";
const subtitle = rawSubtitle ? getLocationText(rawSubtitle) : "";
const badge = rawBadge ? getLocationText(rawBadge) : "Emergency 24/7";
const buttonText = getLocationText(rawButtonText);
const buttonHref = getLocationText(rawButtonHref);

const slides = rawSlides.length > 0 ? rawSlides.map(slide => ({
  ...slide,
  title: getLocationText(slide.title),
  subtitle: slide.subtitle ? getLocationText(slide.subtitle) : undefined,
  promoTitle: slide.promoTitle ? getLocationText(slide.promoTitle) : undefined,
  promoText: slide.promoText ? getLocationText(slide.promoText) : undefined,
})) : [{
  title: title,
  subtitle: subtitle,
  image: rawImage,
  buttonText: buttonText
}];

const currentImage = slides.length > 0 ? slides[0].image : rawImage;
const currentTitle = slides.length > 0 ? slides[0].title : title;
const currentSubtitle = slides.length > 0 ? slides[0].subtitle : subtitle;
---

<section class="relative bg-[#f8faff] pt-32 pb-24 lg:pt-48 lg:pb-24 overflow-hidden">
  
  {/* Ambient Depth Background */}
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-[#3B82F6]/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-0 left-0 w-[40%] h-[40%] bg-[#16A34A]/5 blur-[100px] rounded-full"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-7xl mx-auto">
      <div id="hero-carousel" class="relative">
        {slides.map((slide, index) => (
          <div 
            class={`hero-slide transition-all duration-1000 absolute inset-0 opacity-0 pointer-events-none ${index === 0 ? 'active' : ''}`}
            data-index={index}
          >
            <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-center">
              
              {/* Left: Content Wing - Maintaining strong typography */}
              <div class="lg:col-span-6 relative z-20" data-animate="fade-right">
                <div class="inline-flex items-center gap-3 bg-white px-5 py-2 rounded-full clay-badge mb-8 shadow-sm">
                  <div class="w-2 h-2 rounded-full bg-[#3B82F6] animate-pulse"></div>
                  <span class="text-[10px] clay-subtitle font-black uppercase tracking-[0.3em] text-[#3B82F6]">{badge}</span>
                </div>
                
                <h1 class="clay-title text-5xl md:text-7xl lg:text-[5.5rem] font-black text-[#1C398E] leading-[0.95] tracking-tighter mb-8 slide-title">
                  {slide.title}
                </h1>
                
                <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 font-medium max-w-xl leading-relaxed mb-12" set:html={slide.subtitle} />
                
                <div class="flex flex-wrap gap-6 mb-16">
                  <a href="/contact" class="group relative px-10 py-5 bg-[#3B82F6] text-white rounded-[24px] shadow-clayButton-blue transition-all duration-300 hover:scale-105 hover:-translate-y-1 active:scale-95">
                    <span class="relative z-10 text-sm font-black uppercase tracking-[0.2em]">Schedule Service</span>
                  </a>
                </div>

                {/* Inline Indicators - perfectly tied to text flow */}
                {slides.length > 1 && (
                  <div class="flex gap-4 pointer-events-auto">
                    {slides.map((_, i) => (
                      <button 
                        class={`w-12 h-3 rounded-full transition-all duration-500 clay-indicator ${i === index ? 'active' : ''}`}
                        data-index={i}
                        aria-label={`Go to slide ${i + 1}`}
                      ></button>
                    ))}
                  </div>
                )}
              </div>

              {/* Right: Visual Core - Rebalanced for weight */}
              <div class="lg:col-span-6 relative flex justify-end" data-animate="fade-left">
                <div class="relative w-full max-w-[540px]">
                  
                  {/* Decorative Background Slab - Adds visual volume */}
                  <div class="absolute -inset-4 lg:-inset-8 bg-[#f0f4ff] rounded-[80px] shadow-clayInner rotate-3 pointer-events-none"></div>
                  
                  {/* The Main Sculpted Image Card */}
                  <div class="relative z-10 group">
                    <div class="bg-white p-4 lg:p-6 rounded-[70px] shadow-clayCard-deep relative overflow-hidden -rotate-2 group-hover:rotate-0 transition-all duration-700">
                      <div class="aspect-[4/5] rounded-[55px] overflow-hidden shadow-inner-clay relative">
                        <img 
                          src={slide.image} 
                          alt={slide.title} 
                          class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-[3000ms]"
                          fetchpriority="high"
                          loading="eager"
                          decoding="sync"
                          width="800"
                          height="1000"
                        />
                        <div class="absolute inset-0 bg-gradient-to-t from-[#1C398E]/30 to-transparent mix-blend-overlay"></div>
                      </div>
                    </div>

                    {/* THE HOOK: Redesigned for balance */}
                    {slide.promoTitle && (
                      <div class="promo-hook absolute top-12 -right-4 lg:-right-12 w-52 lg:w-64 z-30 transition-all duration-700 group-hover:scale-110 group-hover:-translate-y-2">
                        {/* Pulsing Aura */}
                        <div class="absolute inset-0 bg-[#16A34A]/30 rounded-[40px] blur-2xl animate-pulse-slow"></div>
                        
                        <div class="relative bg-[#16A34A] p-6 lg:p-8 rounded-[40px] shadow-clayStamp border-4 border-white/30 overflow-hidden group/badge">
                          <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/20 to-white/0 -translate-x-full group-hover/badge:translate-x-full transition-transform duration-1000"></div>
                          
                          <div class="relative z-10 text-center">
                            <div class="inline-block px-3 py-1 bg-white/20 rounded-full mb-3">
                              <span class="text-[8px] font-black text-white uppercase tracking-[0.3em]">Flash Deal</span>
                            </div>
                            <h4 class="text-3xl lg:text-4xl font-black text-white tracking-tighter leading-none mb-2">
                              {slide.promoTitle}
                            </h4>
                            <p class="text-[10px] font-bold text-white/80 uppercase tracking-widest leading-tight mb-6">
                              {slide.promoText}
                            </p>
                            
                            <a href="/contact" class="group/btn relative flex items-center justify-center gap-2 w-full py-4 bg-white text-[#16A34A] rounded-[20px] shadow-[0_8px_16px_rgba(0,0,0,0.1),inset_-2px_-2px_4px_rgba(0,0,0,0.05),inset_2px_2px_4px_rgba(255,255,255,0.8)] transition-all duration-300 hover:bg-[#f8faff] hover:text-[#1C398E] hover:scale-105 hover:-translate-y-1 active:scale-95">
                              <span class="relative z-10 text-[10px] font-black uppercase tracking-[0.2em]">Claim Offer</span>
                              <svg class="relative z-10 transition-transform group-hover/btn:translate-x-1" xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><path d="m9 18 6-6-6-6"/></svg>
                            </a>
                          </div>
                          <div class="absolute -left-3 top-1/2 -translate-y-1/2 w-6 h-6 bg-[#f8faff] rounded-full shadow-inner-clay"></div>
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Visual Accessory - Adds stability to the bottom */}
                  <div class="absolute -bottom-10 -left-10 w-32 h-32 bg-[#3B82F6]/10 rounded-full blur-3xl animate-pulse"></div>
                </div>
              </div>

            </div>
          </div>
        ))}
        

      </div>
    </div>
  </div>
</section>

<style>
  .hero-slide.active {
    opacity: 1;
    pointer-events: auto;
    position: relative;
    z-index: 10;
  }

  .hero-slide:not(.active) {
    transform: scale(0.9) translateY(40px);
    filter: blur(10px);
  }

  .clay-indicator.active {
    background-color: #3B82F6;
    width: 48px;
    box-shadow: inset 2px 2px 4px rgba(0,0,0,0.2), 0 4px 12px rgba(59,130,246,0.3);
  }
  
  .clay-indicator:not(.active) {
    background-color: rgba(28, 57, 142, 0.1);
    box-shadow: inset -2px -2px 4px rgba(255,255,255,0.8), inset 2px 2px 4px rgba(0,0,0,0.05);
  }

  .clay-inner-groove {
    box-shadow: 
      inset 4px 4px 8px rgba(28, 57, 142, 0.05),
      inset -4px -4px 8px rgba(255, 255, 255, 1);
  }

  /* Clay Foundations */
  .shadow-clayCard-deep {
    box-shadow: 
      30px 30px 60px rgba(28, 57, 142, 0.12),
      -20px -20px 40px rgba(255, 255, 255, 1),
      inset 4px 4px 12px rgba(255, 255, 255, 0.8);
  }

  .shadow-clayCard-sm {
    box-shadow: 
      10px 10px 20px rgba(28, 57, 142, 0.05),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 2px 2px 4px rgba(255, 255, 255, 0.5);
  }

  .shadow-clayStamp {
    box-shadow: 
      0 20px 50px rgba(22, 163, 74, 0.4),
      inset -10px -10px 20px rgba(0, 0, 0, 0.2),
      inset 10px 10px 20px rgba(255, 255, 255, 0.4);
  }

  .shadow-clayButton-sm {
    box-shadow: 
      0 8px 16px rgba(0, 0, 0, 0.1),
      inset -2px -2px 4px rgba(0, 0, 0, 0.05),
      inset 2px 2px 4px rgba(255, 255, 255, 0.5);
  }

  .shadow-clayButton-blue {
    box-shadow: 
      0 15px 30px rgba(59, 130, 246, 0.4),
      inset -4px -4px 8px rgba(0, 0, 0, 0.1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.3);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 16px 16px 32px rgba(28, 57, 142, 0.08),
      inset -16px -16px 32px rgba(255, 255, 255, 1);
  }

  .shadow-inner-clay {
    box-shadow: 
      inset 4px 4px 8px rgba(28, 57, 142, 0.08),
      inset -4px -4px 8px rgba(255, 255, 255, 1);
  }

  @keyframes pulse-slow {
    0%, 100% { opacity: 0.3; transform: scale(1); }
    50% { opacity: 0.6; transform: scale(1.15); }
  }

  .animate-pulse-slow {
    animation: pulse-slow 3s ease-in-out infinite;
  }
</style>

<script>
  function initHeroCarousel() {
    const carousel = document.getElementById('hero-carousel');
    if (!carousel) return;

    const slides = carousel.querySelectorAll('.hero-slide');
    const indicators = carousel.querySelectorAll('.clay-indicator');
    let currentSlide = 0;
    const intervalTime = 6000;

    function showSlide(index: number) {
      slides.forEach((slide, i) => {
        if (i === index) {
          slide.classList.add('active');
        } else {
          slide.classList.remove('active');
        }
      });
      
      indicators.forEach((indicator) => {
        const idx = parseInt((indicator as HTMLElement).dataset.index || '0');
        if (idx === index) {
          indicator.classList.add('active');
        } else {
          indicator.classList.remove('active');
        }
      });
    }

    function nextSlide() {
      currentSlide = (currentSlide + 1) % slides.length;
      showSlide(currentSlide);
    }

    let slideInterval = setInterval(nextSlide, intervalTime);

    indicators.forEach((indicator, index) => {
      indicator.addEventListener('click', () => {
        const idx = parseInt((indicator as HTMLElement).dataset.index || '0');
        currentSlide = idx;
        showSlide(currentSlide);
        clearInterval(slideInterval);
        slideInterval = setInterval(nextSlide, intervalTime);
      });
    });
  }

  initHeroCarousel();
  document.addEventListener('astro:after-swap', initHeroCarousel);
</script>
