---
import { getLocationText } from "@/config/brand-settings"

interface HeroSlide {
  title: string;
  subtitle?: string;
  image: string;
  promoTitle?: string;
  promoText?: string;
  promoImage?: string;
  buttonText?: string;
}

interface Props {
  badge?: string;
  title: string;
  subtitle?: string;
  buttonText?: string;
  buttonHref?: string;
  image?: string;
  slides?: HeroSlide[];
  variant?: "default" | "subpage" | "category";
  trustIndicators?: string[];
}

const {
  badge: rawBadge,
  title: rawTitle,
  subtitle: rawSubtitle,
  buttonText: rawButtonText = "Call Now",
  buttonHref: rawButtonHref = "tel:{phoneRaw}",
  image: rawImage,
  slides: rawSlides = [],
  variant = "default",
} = Astro.props;

const title = rawTitle ? getLocationText(rawTitle) : "";
const subtitle = rawSubtitle ? getLocationText(rawSubtitle) : "";
const badge = rawBadge ? getLocationText(rawBadge) : "Emergency 24/7";
const buttonText = getLocationText(rawButtonText);
const buttonHref = getLocationText(rawButtonHref);

const slides = rawSlides.map(slide => ({
  ...slide,
  title: getLocationText(slide.title),
  subtitle: slide.subtitle ? getLocationText(slide.subtitle) : undefined,
  promoTitle: slide.promoTitle ? getLocationText(slide.promoTitle) : undefined,
  promoText: slide.promoText ? getLocationText(slide.promoText) : undefined,
}));

const currentImage = slides.length > 0 ? slides[0].image : rawImage;
const currentTitle = slides.length > 0 ? slides[0].title : title;
const currentSubtitle = slides.length > 0 ? slides[0].subtitle : subtitle;
---

<section class="relative bg-[#f8faff] pt-32 pb-24 lg:pt-48 lg:pb-40 overflow-hidden">
  
  {/* Ambient Depth Background */}
  <div class="absolute inset-0 pointer-events-none">
    <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-[#3B82F6]/5 blur-[120px] rounded-full"></div>
    <div class="absolute bottom-0 left-0 w-[40%] h-[40%] bg-[#16A34A]/5 blur-[100px] rounded-full"></div>
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-10">
      
      {/* 1. Main Visual Bento (8 Columns) */}
      <div class="lg:col-span-8 relative group" data-animate="fade-right">
        <div class="bg-white p-4 rounded-[60px] shadow-clayCard h-[500px] lg:h-[700px] overflow-hidden relative">
          <div class="w-full h-full rounded-[48px] overflow-hidden shadow-clayInner relative">
            <img 
              src={currentImage} 
              alt="Hero" 
              class="w-full h-full object-cover transition-transform duration-[3000ms] group-hover:scale-110"
            />
            {/* Glass Overlay for Title */}
            <div class="absolute bottom-6 left-6 right-6 lg:bottom-10 lg:left-10 lg:right-10 bg-white/30 backdrop-blur-2xl p-8 lg:p-12 rounded-[40px] lg:rounded-[60px] shadow-clayFloating border border-white/50">
              <div class="inline-flex items-center gap-2 bg-white/90 px-4 py-1.5 rounded-full shadow-clayButton mb-6">
                <div class="w-2 h-2 rounded-full bg-[#16A34A] animate-pulse"></div>
                <span class="text-[10px] font-black text-[#1C398E] uppercase tracking-widest" style="font-family: 'JetBrains Mono', monospace;">{badge}</span>
              </div>
              <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-[#1C398E] leading-[1.1] tracking-tight mb-4" style="font-family: 'Poppins', sans-serif;">
                {currentTitle}
              </h1>
              <p class="text-lg lg:text-xl text-[#1C398E]/80 font-medium max-w-2xl" style="font-family: 'Montserrat', sans-serif;">
                {currentSubtitle}
              </p>
            </div>
          </div>
        </div>
      </div>

      {/* 2. Side Bento Stack (4 Columns) */}
      <div class="lg:col-span-4 flex flex-col gap-8 lg:gap-10">
        
        {/* Call Now Bento */}
        <div class="bg-[#1C398E] p-8 rounded-[50px] shadow-clayFloating flex flex-col justify-between items-start group relative overflow-hidden" data-animate="fade-left" style="animation-delay: 0.1s;">
          <div class="relative z-10">
            <div class="w-14 h-14 rounded-full bg-[#3B82F6] shadow-clayButton flex items-center justify-center text-white mb-6 group-hover:scale-110 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
            </div>
            <h3 class="text-2xl font-black text-white uppercase tracking-tight mb-2" style="font-family: 'Poppins', sans-serif;">Need A Plumber?</h3>
            <p class="text-white/40 text-sm font-bold uppercase tracking-widest mb-8" style="font-family: 'JetBrains Mono', monospace;">Average response: 45m</p>
          </div>
          <a href={buttonHref} class="relative z-10 w-full bg-[#3B82F6] h-16 rounded-[24px] shadow-clayButton flex items-center justify-center text-white font-black uppercase tracking-widest text-sm hover:brightness-110 transition-all">
            {buttonText}
          </a>
          <div class="absolute -right-10 -bottom-10 w-40 h-40 bg-[#3B82F6]/10 rounded-full blur-2xl"></div>
        </div>

        {/* Review Bento */}
        <div class="bg-white p-8 rounded-[50px] shadow-clayCard flex flex-col items-center text-center justify-center group" data-animate="fade-left" style="animation-delay: 0.2s;">
          <div class="flex gap-1 mb-4">
            {[1,2,3,4,5].map(() => (
              <svg class="w-6 h-6 text-[#D97706] fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/></svg>
            ))}
          </div>
          <p class="text-3xl font-black text-[#1C398E] mb-2" style="font-family: 'Poppins', sans-serif;">4.9/5 Rating</p>
          <p class="text-[#1C398E]/50 font-medium text-sm mb-6" style="font-family: 'Montserrat', sans-serif;">Based on 2,500+ Local Reviews</p>
          <div class="flex -space-x-3">
            {[1,2,3,4].map(i => (
              <div class="w-10 h-10 rounded-full border-4 border-white bg-[#f8faff] shadow-clayButton overflow-hidden flex items-center justify-center">
                 <div class="w-full h-full bg-[#3B82F6]/10 text-[#3B82F6] flex items-center justify-center font-black text-[10px]">P</div>
              </div>
            ))}
          </div>
        </div>

        {/* Quick Quote Bento */}
        <a href="/contact" class="flex-1 bg-[#16A34A] p-8 rounded-[50px] shadow-clayFloating flex items-center justify-between group hover:brightness-105 transition-all" data-animate="fade-left" style="animation-delay: 0.3s;">
           <div class="text-left">
              <p class="text-white/40 text-[9px] font-black uppercase tracking-[0.3em] mb-1">Instant Booking</p>
              <h3 class="text-xl lg:text-2xl font-black text-white uppercase tracking-tight" style="font-family: 'Poppins', sans-serif;">Get A Fast Quote</h3>
           </div>
           <div class="w-12 h-12 rounded-full bg-white/20 shadow-clayButton flex items-center justify-center text-white group-hover:translate-x-2 transition-transform">
              <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
           </div>
        </a>
      </div>

    </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      24px 24px 48px rgba(28, 57, 142, 0.08),
      -16px -16px 32px rgba(255, 255, 255, 1),
      inset 4px 4px 12px rgba(255, 255, 255, 0.8);
  }

  .shadow-clayButton {
    box-shadow: 
      10px 10px 20px rgba(0, 0, 0, 0.06),
      -6px -6px 12px rgba(255, 255, 255, 0.2),
      inset 2px 2px 4px rgba(255, 255, 255, 0.4);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 16px 16px 32px rgba(28, 57, 142, 0.08),
      inset -16px -16px 32px rgba(255, 255, 255, 1);
  }

  .shadow-clayFloating {
    box-shadow: 30px 30px 60px rgba(0, 0, 0, 0.1);
  }
</style>
