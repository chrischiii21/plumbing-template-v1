---
import { getLocationText, processLocationArray } from "@/config/brand-settings"
import { MapPin, Globe, Navigation, Search, CheckCircle2, ArrowRight } from "lucide-react"

interface Props {
  title: string;
  description: string;
  areas?: string[];
  mapImage?: string;
  mapEmbed?: string;
  mapAddress?: string;
  variant?: "full" | "compact";
  buttonText?: string;
  buttonHref?: string;
}

const { 
  title: rawTitle, 
  description: rawDescription, 
  areas: rawAreas, 
  mapImage, 
  mapEmbed, 
  mapAddress: rawMapAddress,
  variant = "full",
  buttonText: rawButtonText = "Explore All Locations",
  buttonHref = "/service-areas"
} = Astro.props;

const title = getLocationText(rawTitle);
const description = getLocationText(rawDescription);
const areas = rawAreas ? processLocationArray(rawAreas) : undefined;
const mapAddress = rawMapAddress ? getLocationText(rawMapAddress) : undefined;
const buttonText = getLocationText(rawButtonText);

const getMapEmbedUrl = (address: string) => {
  const encodedAddress = encodeURIComponent(address);
  return `https://www.google.com/maps?q=${encodedAddress}&output=embed`;
};

const embedUrl = mapEmbed || (mapAddress ? getMapEmbedUrl(mapAddress) : null);
---

<section class="py-32 bg-[#f8faff] relative overflow-hidden">
  
  {/* Fluid Background Accents */}
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#3B82F6]/3 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#16A34A]/3 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    
    {/* The Fluid Ribbon Chassis */}
    <div class="relative bg-white rounded-[60px] lg:rounded-[80px] shadow-clayCard p-8 lg:p-12 flex flex-col lg:flex-row items-center lg:items-stretch gap-12 lg:gap-16 overflow-hidden border border-white">
      
      {/* Decorative Blob cut-out effect */}
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-[#f8faff] rounded-full shadow-clayInner pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-[#f8faff] rounded-full shadow-clayInner pointer-events-none"></div>

      {/* 1. The Map Display (Left) */}
      <div class="w-full lg:w-[45%] shrink-0 relative flex flex-col min-h-[350px] lg:min-h-0" data-animate="fade-right">
        <div class="w-full flex-grow rounded-[32px] lg:rounded-[48px] bg-[#f8faff] p-3 lg:p-4 shadow-clayInner border-4 lg:border-[6px] border-white group flex flex-col">
          <div class="w-full flex-grow rounded-[20px] lg:rounded-[32px] overflow-hidden shadow-clayCard relative">
             {embedUrl ? (
                <iframe
                  src={embedUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Service Area Map"
                  class="opacity-90 group-hover:opacity-100 transition-opacity duration-1000 absolute inset-0 w-full h-full"
                ></iframe>
              ) : (
                <div class="w-full h-full bg-white flex items-center justify-center absolute inset-0">
                  <Globe className="w-16 h-16 text-[#3B82F6]/10 animate-pulse" />
                </div>
              )}
              {/* Pulsing Pin */}
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none">
                 <div class="w-10 h-10 bg-[#3B82F6] rounded-full shadow-clayButton flex items-center justify-center text-white border-[3px] border-white animate-bounce">
                    <MapPin className="w-5 h-5" />
                 </div>
              </div>
          </div>
        </div>
      </div>

      {/* 2. Content & City Cloud (Right) */}
      <div class="flex-1 text-center lg:text-left relative z-10 flex flex-col justify-center" data-animate="fade-left">
        <h2 class="text-4xl lg:text-6xl font-black text-[#1C398E] mb-6 leading-[0.95] tracking-tighter uppercase" style="font-family: 'Poppins', sans-serif;">
          {title.split(' ').map((word, i) => (
             <span class={i % 2 === 1 ? 'text-[#3B82F6]' : ''}>{word} </span>
          ))}
        </h2>

        <p class="text-base lg:text-lg text-[#1C398E]/60 mb-8 leading-relaxed font-medium max-w-2xl" style="font-family: 'Montserrat', sans-serif;" set:html={description} />

        {variant !== "full" && (
          <div class="flex justify-center lg:justify-start mb-8">
             <a href={buttonHref} class="clay-btn-primary h-16 px-10 text-[13px] text-white font-black uppercase tracking-widest inline-flex items-center justify-center group w-full sm:w-auto">
                {buttonText}
                <ArrowRight className="w-5 h-5 ml-4 group-hover:translate-x-2 transition-transform" />
             </a>
          </div>
        )}

        {/* Organic City Cloud */}
        {areas && areas.length > 0 && (
          <div class="flex flex-wrap justify-center lg:justify-start gap-3 lg:gap-4">
            {areas.slice(0, 12).map((area, i) => (
              <div 
                class={`px-6 py-2.5 rounded-full bg-white shadow-clayButton border-2 border-[#f8faff] hover:shadow-clayInner hover:-translate-y-1 transition-all duration-500 cursor-pointer group flex items-center gap-2.5`}
                style={`animation-delay: ${i * 0.05}s`}
              >
                <div class="w-1.5 h-1.5 rounded-full bg-[#16A34A] group-hover:scale-150 transition-transform"></div>
                <span class="text-[10px] font-black text-[#1C398E] uppercase tracking-widest">{area}</span>
              </div>
            ))}
          </div>
        )}
      </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      24px 24px 48px rgba(28, 57, 142, 0.08),
      -16px -16px 32px rgba(255, 255, 255, 1),
      inset 4px 4px 10px rgba(255, 255, 255, 0.8);
  }

  .shadow-clayButton {
    box-shadow: 
      8px 8px 16px rgba(28, 57, 142, 0.06),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.05),
      inset -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayFloating {
    box-shadow: 40px 40px 80px rgba(28, 57, 142, 0.15);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 40px;
    box-shadow: 
      12px 12px 24px rgba(59, 130, 246, 0.3),
      inset 6px 6px 12px rgba(255, 255, 255, 0.3),
      inset -6px -6px 12px rgba(0, 0, 0, 0.1);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .clay-btn-primary:hover {
    transform: translateY(-4px);
    filter: brightness(1.05);
    box-shadow: 16px 16px 32px rgba(59, 130, 246, 0.4);
  }

  @keyframes clay-float {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-20px) rotate(3deg); }
  }
  .animate-clay-float {
    animation: clay-float 6s ease-in-out infinite;
  }
</style>
