---
import { getLocationText, processLocationArray } from "@/config/brand-settings"
import { MapPin, Globe, Navigation, Search, CheckCircle2, ArrowRight } from "lucide-react"

interface Props {
  title: string;
  description: string;
  areas?: string[];
  mapImage?: string;
  mapEmbed?: string;
  mapAddress?: string;
  variant?: "full" | "compact";
  buttonText?: string;
  buttonHref?: string;
}

const { 
  title: rawTitle, 
  description: rawDescription, 
  areas: rawAreas, 
  mapImage, 
  mapEmbed, 
  mapAddress: rawMapAddress,
  variant = "full",
  buttonText: rawButtonText = "Explore All Locations",
  buttonHref = "/service-areas"
} = Astro.props;

const title = getLocationText(rawTitle);
const description = getLocationText(rawDescription);
const areas = rawAreas ? processLocationArray(rawAreas) : undefined;
const mapAddress = rawMapAddress ? getLocationText(rawMapAddress) : undefined;
const buttonText = getLocationText(rawButtonText);

const getMapEmbedUrl = (address: string) => {
  const encodedAddress = encodeURIComponent(address);
  return `https://www.google.com/maps?q=${encodedAddress}&output=embed`;
};

const embedUrl = mapEmbed || (mapAddress ? getMapEmbedUrl(mapAddress) : null);
---

<section class="py-32 bg-[#f8faff] relative overflow-hidden">
  
  {/* Fluid Background Accents */}
  <div class="absolute top-0 right-0 w-[600px] h-[600px] bg-[#3B82F6]/3 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[500px] h-[500px] bg-[#16A34A]/3 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    
    {/* The Fluid Ribbon Chassis */}
    <div class="relative bg-white rounded-[80px] lg:rounded-[120px] shadow-clayCard p-8 lg:p-16 flex flex-col lg:flex-row items-center gap-16 lg:gap-24 overflow-hidden border border-white">
      
      {/* Decorative Blob cut-out effect */}
      <div class="absolute -top-24 -left-24 w-64 h-64 bg-[#f8faff] rounded-full shadow-clayInner pointer-events-none"></div>
      <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-[#f8faff] rounded-full shadow-clayInner pointer-events-none"></div>

      {/* 1. The Map Aperture (Left) */}
      <div class="w-full lg:w-2/5 shrink-0 relative" data-animate="fade-right">
        <div class="aspect-square rounded-full bg-[#f8faff] p-6 shadow-clayInner border-8 border-white group">
          <div class="w-full h-full rounded-full overflow-hidden shadow-clayCard relative">
             {embedUrl ? (
                <iframe
                  src={embedUrl}
                  width="100%"
                  height="100%"
                  style="border:0;"
                  allowfullscreen=""
                  loading="lazy"
                  referrerpolicy="no-referrer-when-downgrade"
                  title="Service Area Map"
                  class="grayscale-[0.6] opacity-90 group-hover:grayscale-0 group-hover:opacity-100 transition-all duration-[2000ms] scale-125"
                ></iframe>
              ) : (
                <div class="w-full h-full bg-white flex items-center justify-center">
                  <Globe className="w-20 h-20 text-[#3B82F6]/10 animate-pulse" />
                </div>
              )}
              {/* Pulsing Pin */}
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 pointer-events-none">
                 <div class="w-12 h-12 bg-[#3B82F6] rounded-full shadow-clayButton flex items-center justify-center text-white border-4 border-white animate-bounce">
                    <MapPin className="w-6 h-6" />
                 </div>
              </div>
          </div>
        </div>

        {/* Floating Stat Card */}
        <div class="absolute -bottom-6 -right-6 lg:-bottom-10 lg:-right-10 z-20 animate-clay-float">
           <div class="bg-white/90 backdrop-blur-xl p-8 rounded-[40px] shadow-clayFloating border-2 border-white flex flex-col items-center">
              <span class="text-4xl font-black text-[#16A34A] mb-1" style="font-family: 'Poppins', sans-serif;">20+</span>
              <span class="text-[9px] font-black text-[#1C398E]/40 uppercase tracking-[0.3em]">Cities Covered</span>
           </div>
        </div>
      </div>

      {/* 2. Content & City Cloud (Right) */}
      <div class="flex-1 text-center lg:text-left relative z-10" data-animate="fade-left">
        <div class="inline-flex items-center gap-3 bg-[#f8faff] px-5 py-2 rounded-full shadow-clayInner mb-8">
           <Navigation className="w-4 h-4 text-[#3B82F6]" />
           <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[#1C398E]" style="font-family: 'JetBrains Mono', monospace;">Service Perimeter</span>
        </div>

        <h2 class="text-5xl lg:text-7xl font-black text-[#1C398E] mb-8 leading-[0.95] tracking-tighter uppercase" style="font-family: 'Poppins', sans-serif;">
          {title.split(' ').map((word, i) => (
             <span class={i % 2 === 1 ? 'text-[#3B82F6]' : ''}>{word} </span>
          ))}
        </h2>

        <p class="text-lg lg:text-xl text-[#1C398E]/60 mb-12 leading-relaxed font-medium max-w-2xl" style="font-family: 'Montserrat', sans-serif;" set:html={description} />

        {/* Organic City Cloud */}
        {areas && areas.length > 0 && (
          <div class="flex flex-wrap justify-center lg:justify-start gap-4 lg:gap-6 mb-14">
            {areas.slice(0, 12).map((area, i) => (
              <div 
                class={`px-8 py-3 rounded-full bg-white shadow-clayButton border-2 border-[#f8faff] hover:shadow-clayInner hover:-translate-y-1 transition-all duration-500 cursor-pointer group flex items-center gap-3`}
                style={`animation-delay: ${i * 0.1}s`}
              >
                <div class="w-2 h-2 rounded-full bg-[#16A34A] group-hover:scale-150 transition-transform"></div>
                <span class="text-[11px] font-black text-[#1C398E] uppercase tracking-widest">{area}</span>
              </div>
            ))}
          </div>
        )}

        <div class="flex flex-col sm:flex-row items-center gap-6">
           <a href={buttonHref} class="clay-btn-primary h-20 px-12 text-sm text-white font-black uppercase tracking-widest flex items-center justify-center group w-full sm:w-auto">
              {buttonText}
              <ArrowRight className="w-5 h-5 ml-4 group-hover:translate-x-2 transition-transform" />
           </a>
           <div class="flex items-center gap-3 text-[#16A34A]">
              <CheckCircle2 className="w-6 h-6" />
              <span class="text-xs font-black uppercase tracking-widest">Licensed in all Areas</span>
           </div>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  /* Clay Foundations */
  .shadow-clayCard {
    box-shadow: 
      24px 24px 48px rgba(28, 57, 142, 0.08),
      -16px -16px 32px rgba(255, 255, 255, 1),
      inset 4px 4px 10px rgba(255, 255, 255, 0.8);
  }

  .shadow-clayButton {
    box-shadow: 
      8px 8px 16px rgba(28, 57, 142, 0.06),
      -8px -8px 16px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6);
  }

  .shadow-clayInner {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.05),
      inset -12px -12px 24px rgba(255, 255, 255, 1);
  }

  .shadow-clayFloating {
    box-shadow: 40px 40px 80px rgba(28, 57, 142, 0.15);
  }

  .clay-btn-primary {
    background: #3B82F6;
    border-radius: 40px;
    box-shadow: 
      12px 12px 24px rgba(59, 130, 246, 0.3),
      inset 6px 6px 12px rgba(255, 255, 255, 0.3),
      inset -6px -6px 12px rgba(0, 0, 0, 0.1);
    transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
  }

  .clay-btn-primary:hover {
    transform: translateY(-4px);
    filter: brightness(1.05);
    box-shadow: 16px 16px 32px rgba(59, 130, 246, 0.4);
  }

  @keyframes clay-float {
    0%, 100% { transform: translateY(0) rotate(0); }
    50% { transform: translateY(-20px) rotate(3deg); }
  }
  .animate-clay-float {
    animation: clay-float 6s ease-in-out infinite;
  }
</style>
