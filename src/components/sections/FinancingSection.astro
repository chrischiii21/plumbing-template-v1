---
import { getLocationText } from "@/config/brand-settings";
import { Wallet, CreditCard, CheckCircle2 } from "lucide-react";

interface Step {
  title: string;
  description: string;
}

interface Props {
  badge?: string;
  title: string;
  description: string;
  paymentPlans: string[];
  financingOptions: string[];
  steps: Step[];
}

const {
  badge: raw_badge = "Financing",
  title: raw_title,
  description: raw_description,
  paymentPlans,
  financingOptions,
  steps,
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description
  ? getLocationText(raw_description)
  : raw_description;
const badge = raw_badge ? getLocationText(raw_badge) : raw_badge;
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap"
  rel="stylesheet"
/>

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Clay Blobs */}
  <div
    class="absolute top-1/2 -right-20 w-96 h-96 bg-[#3B82F6]/10 rounded-full blur-[100px] pointer-events-none animate-pulse"
  >
  </div>
  <div
    class="absolute bottom-0 -left-20 w-80 h-80 bg-[#16A34A]/10 rounded-full blur-[100px] pointer-events-none"
  >
  </div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="text-center mb-16 md:mb-24" data-animate="fade-up">
      <div
        class="inline-flex items-center gap-3 bg-white px-6 py-2 rounded-full clay-badge mb-6"
      >
        <Wallet className="w-4 h-4 text-[#3B82F6]" />
        <span
          class="text-[0.65rem] font-mono font-bold uppercase tracking-[0.25em] text-[#3B82F6]"
          >{badge}</span
        >
      </div>
      <h2
        class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] mb-8 tracking-tighter leading-tight"
      >
        {title}
      </h2>
      <p
        class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed"
        set:html={description}
      />
    </div>

    <div
      class="grid lg:grid-cols-12 gap-12 lg:gap-16 max-w-6xl mx-auto mb-32 items-center"
    >
      {/* Left: What Can You Finance? (Fluid Grid of Chips) */}
      <div
        class="lg:col-span-7 flex flex-col justify-center"
        data-animate="fade-right"
      >
        <div class="flex items-center gap-4 mb-8">
          <div
            class="w-12 h-12 rounded-full bg-[#16A34A]/10 flex items-center justify-center clay-badge text-[#16A34A]"
          >
            <CheckCircle2 className="w-6 h-6" />
          </div>
          <h3 class="clay-title text-3xl font-black text-[#1C398E]">
            What Can You Finance?
          </h3>
        </div>

        <div class="grid sm:grid-cols-2 gap-5">
          {
            financingOptions.map((option) => (
              <div class="p-6 bg-white rounded-[24px] clay-card-compact group hover:-translate-y-1 hover:shadow-[10px_10px_20px_rgba(22,163,116,0.1),-10px_-10px_20px_rgba(255,255,255,1)] transition-all duration-300">
                <div class="w-10 h-10 rounded-full bg-[#16A34A] text-white flex items-center justify-center mb-4 shadow-clayButton group-hover:scale-110 transition-transform">
                  <CheckCircle2 className="w-5 h-5" />
                </div>
                <span class="text-sm font-black text-[#1C398E] uppercase tracking-wide leading-tight block">
                  {option}
                </span>
              </div>
            ))
          }
        </div>
      </div>

      {/* Right: Flexible Payment Plans */}
      <div class="lg:col-span-5 w-full h-full" data-animate="fade-left">
        <div
          class="relative w-full h-full rounded-[40px] bg-white p-8 md:p-10 shadow-clayCard overflow-hidden flex flex-col group hover:-translate-y-1 transition-all duration-500 border border-[#3B82F6]/5"
        >
          {/* Card Decorations */}
          <div
            class="absolute -right-10 -top-10 w-64 h-64 bg-[#3B82F6]/5 rounded-full blur-3xl pointer-events-none group-hover:scale-110 transition-all duration-700"
          >
          </div>

          <div class="relative z-10 flex flex-col h-full">
            <div class="flex items-center gap-4 mb-8">
              <div
                class="w-12 h-12 rounded-full bg-[#3B82F6]/10 flex items-center justify-center shadow-clayInner text-[#3B82F6]"
              >
                <CreditCard className="w-6 h-6" />
              </div>
              <h3 class="clay-title text-2xl font-black text-[#1C398E]">
                Flexible Payment Plans
              </h3>
            </div>

            <ul class="space-y-4 flex-grow flex flex-col justify-center">
              {
                paymentPlans.map((plan) => (
                  <li class="flex items-start gap-4 bg-[#f8faff] p-5 rounded-[24px] border border-[#3B82F6]/5 shadow-clayInner group-hover:shadow-clayCard transition-all duration-300">
                    <div class="w-8 h-8 rounded-full bg-white shadow-clayButton flex items-center justify-center shrink-0 text-[#3B82F6]">
                      <CheckCircle2 className="w-4 h-4" />
                    </div>
                    <span class="text-xs sm:text-sm font-bold text-[#1C398E] uppercase tracking-wide leading-snug mt-0.5">
                      {plan}
                    </span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto">
      <div class="text-center mb-16 md:mb-20">
        <h3
          class="clay-title text-2xl md:text-3xl font-black text-[#1C398E] uppercase tracking-widest bg-white inline-block px-12 py-4 rounded-full clay-badge"
          data-animate="fade-up"
        >
          How to Apply
        </h3>
      </div>

      <div class="relative grid md:grid-cols-3 gap-12 lg:gap-16">
        {/* Connecting Line - Styled as Clay Groove */}
        <div
          class="hidden md:block absolute top-[44px] left-[10%] right-[10%] h-3 rounded-full bg-[#F0F4F9] shadow-inner-clay pointer-events-none"
        >
        </div>

        {
          steps.map((step, index) => (
            <div
              class="relative group will-change-transform"
              data-animate="fade-up"
              style={`animation-delay: ${index * 0.1}s`}
            >
              <div class="clay-card-compact text-center relative z-10 h-full group-hover:-translate-y-2 transition-all duration-500 transform-gpu">
                <div class="absolute -top-9 left-1/2 -translate-x-1/2 w-20 h-20 rounded-full bg-white clay-badge flex items-center justify-center text-2xl font-black text-[#3B82F6] z-20 group-hover:scale-110 transition-transform">
                  <span class="clay-title">{index + 1}</span>
                </div>
                <h4 class="clay-title font-black text-xl text-[#1C398E] mt-4 mb-5 uppercase tracking-tight">
                  {step.title}
                </h4>
                <p
                  class="clay-subtitle text-[15px] text-[#1C398E]/50 font-medium leading-relaxed"
                  set:html={step.description}
                />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3.5rem;
    padding: 3.5rem 2.5rem;
    box-shadow:
      inset -10px -10px 20px rgba(0, 0, 0, 0.02),
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.8);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-card-compact {
    background: #ffffff;
    border-radius: 3rem;
    padding: 3rem 2rem;
    box-shadow:
      inset -8px -8px 16px rgba(0, 0, 0, 0.02),
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.8);
  }

  .clay-badge {
    box-shadow:
      inset -2px -2px 4px rgba(0, 0, 0, 0.05),
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-inner-card {
    box-shadow:
      inset 6px 6px 12px rgba(28, 57, 142, 0.04),
      inset -6px -6px 12px rgba(255, 255, 255, 0.8);
  }

  .shadow-inner-clay {
    box-shadow:
      inset 4px 4px 8px rgba(0, 0, 0, 0.05),
      inset -4px -4px 8px rgba(255, 255, 255, 0.8);
  }

  .clay-dot {
    box-shadow: 0 4px 10px rgba(59, 130, 246, 0.4);
  }

  .clay-dot-success {
    box-shadow: 0 4px 10px rgba(22, 163, 74, 0.4);
  }

  .clay-title {
    font-family: "Poppins", sans-serif;
  }

  .clay-subtitle {
    font-family: "Montserrat", sans-serif;
  }

  .font-mono {
    font-family: "JetBrains Mono", monospace;
  }

  [data-animate] {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
