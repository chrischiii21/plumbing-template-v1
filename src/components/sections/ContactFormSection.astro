---
import { getLocationText } from "@/config/brand-settings"
import { Phone, Mail, MapPin, Send, ShieldCheck, Zap, BellOff, ChevronDown } from "lucide-react"

interface Props {
  title?: string;
  description?: string;
  image?: string;
  phone?: string;
  email?: string;
  address?: string;
  serviceOptions?: string[];
  planOptions?: string[];
}

const {
  title: raw_title = "Get in Touch with {fullName}",
  description: raw_description = "Fill out the form, and a member of our team will get back to you promptly. Whether you're looking for a quick repair, a detailed quote, or general advice, we've got you covered.",
  image = "/images/photos/unsplash-1621905251189-08b45d6a269e-w800.jpg",
  phone: raw_phone = "{phone}",
  email: raw_email = "{email}",
  address: raw_address = "{city}, {state}",
  serviceOptions = ["Residential Plumbing", "Commercial Plumbing", "Emergency Service", "Maintenance", "Other"],
  planOptions = ["Yes", "No", "Not Sure"]
} = Astro.props;

// Process text placeholders
const title = getLocationText(raw_title);
const description = getLocationText(raw_description);
const phone = getLocationText(raw_phone);
const email = getLocationText(raw_email);
const address = getLocationText(raw_address);
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<!-- Contact Section -->
<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-0 left-0 w-[50%] h-[50%] bg-[#3B82F6]/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 right-0 w-[40%] h-[40%] bg-[#16A34A]/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="max-w-4xl mx-auto text-center mb-20" data-animate="fade-up">
      <div class="inline-flex items-center gap-3 bg-white px-6 py-2 rounded-full clay-badge mb-8">
        <Send className="w-4 h-4 text-[#3B82F6]" />
        <span class="text-[0.65rem] font-mono font-bold uppercase tracking-[0.25em] text-[#3B82F6]">Contact Us</span>
      </div>
      <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] mb-8 leading-tight tracking-tighter">{title}</h2>
      <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />
    </div>

    <div class="grid lg:grid-cols-12 gap-12 lg:gap-16 items-start max-w-7xl mx-auto">
      <!-- Info Bento Column -->
      <div class="lg:col-span-5 space-y-8" data-animate="fade-right">
        <!-- Phone Bento -->
        <div class="clay-card group p-8 flex items-center gap-6 hover:-translate-y-2 transition-all duration-500 will-change-transform">
          <div class="w-16 h-16 rounded-full bg-[#3B82F6]/5 flex items-center justify-center clay-badge text-[#3B82F6] group-hover:scale-110 transition-transform">
            <Phone className="w-7 h-7" />
          </div>
          <div>
            <p class="clay-subtitle text-xs font-bold text-[#3B82F6] uppercase tracking-widest mb-1">Phone</p>
            <a href={`tel:${phone}`} class="clay-title text-2xl font-black text-[#1C398E] hover:text-[#3B82F6] transition-colors">{phone}</a>
          </div>
        </div>

        <!-- Email Bento -->
        <div class="clay-card group p-8 flex items-center gap-6 hover:-translate-y-2 transition-all duration-500 will-change-transform">
          <div class="w-16 h-16 rounded-full bg-[#3B82F6]/5 flex items-center justify-center clay-badge text-[#3B82F6] group-hover:scale-110 transition-transform">
            <Mail className="w-7 h-7" />
          </div>
          <div>
            <p class="clay-subtitle text-xs font-bold text-[#3B82F6] uppercase tracking-widest mb-1">Email</p>
            <a href={`mailto:${email}`} class="clay-title text-xl md:text-2xl font-black text-[#1C398E] hover:text-[#3B82F6] transition-colors break-all md:break-normal">{email}</a>
          </div>
        </div>

        <!-- Address Bento -->
        <div class="clay-card group p-8 flex items-center gap-6 hover:-translate-y-2 transition-all duration-500 will-change-transform">
          <div class="w-16 h-16 rounded-full bg-[#3B82F6]/5 flex items-center justify-center clay-badge text-[#3B82F6] group-hover:scale-110 transition-transform">
            <MapPin className="w-7 h-7" />
          </div>
          <div>
            <p class="clay-subtitle text-xs font-bold text-[#3B82F6] uppercase tracking-widest mb-1">Location</p>
            <span class="clay-title text-2xl font-black text-[#1C398E]">{address}</span>
          </div>
        </div>

        <!-- Image Bento -->
        <div class="relative rounded-[3.5rem] overflow-hidden shadow-clayCard h-64 lg:h-80 group">
          <img src={image} alt="Our Expert Team" class="w-full h-full object-cover transition-transform duration-[3000ms] group-hover:scale-110" />
          <div class="absolute inset-0 bg-gradient-to-t from-[#1C398E]/80 via-[#1C398E]/20 to-transparent"></div>
          <div class="absolute bottom-8 left-8">
            <div class="flex items-center gap-2 bg-white/90 backdrop-blur px-4 py-1.5 rounded-full shadow-clayButton">
              <div class="w-2 h-2 rounded-full bg-[#16A34A] animate-pulse"></div>
              <span class="text-[10px] font-mono font-bold text-[#1C398E] uppercase tracking-widest">Available Now</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Form Column -->
      <div class="lg:col-span-7" data-animate="fade-left">
        <div class="clay-card-form p-8 md:p-12 relative overflow-hidden transform-gpu">
          <!-- Form Header -->
          <div class="mb-10">
            <h3 class="clay-title text-3xl font-black text-[#1C398E] mb-2 uppercase tracking-tight">Request Service</h3>
            <div class="w-16 h-1.5 bg-[#3B82F6] rounded-full shadow-sm mb-4"></div>
            <p class="clay-subtitle text-sm text-[#1C398E]/50 font-medium">Expert help is just a few clicks away. We'll respond within 24 hours.</p>
          </div>

          <form class="space-y-6">
            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="name" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Full Name*</label>
                <input type="text" id="name" name="name" required class="clay-input" placeholder="John Doe" />
              </div>
              <div class="space-y-2">
                <label for="phone" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Phone Number</label>
                <input type="tel" id="phone" name="phone" class="clay-input" placeholder="(555) 000-0000" />
              </div>
            </div>

            <div class="space-y-2">
              <label for="email" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Email Address*</label>
              <input type="email" id="email" name="email" required class="clay-input" placeholder="john@example.com" />
            </div>

            <div class="grid md:grid-cols-2 gap-6">
              <div class="space-y-2">
                <label for="service" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Service Needed</label>
                <div class="relative">
                  <select id="service" name="service" class="clay-input appearance-none">
                    <option value="">Select a service</option>
                    {serviceOptions.map((opt) => <option value={opt.toLowerCase()}>{opt}</option>)}
                  </select>
                  <div class="absolute right-5 top-1/2 -translate-y-1/2 w-5 h-5 text-[#3B82F6] pointer-events-none">
                    <ChevronDown className="w-full h-full" strokeWidth={3} />
                  </div>
                </div>
              </div>
              <div class="space-y-2">
                <label for="plan" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Interested in a Plan?</label>
                <div class="relative">
                  <select id="plan" name="plan" class="clay-input appearance-none">
                    <option value="">Select an option</option>
                    {planOptions.map((opt) => <option value={opt.toLowerCase()}>{opt}</option>)}
                  </select>
                  <div class="absolute right-5 top-1/2 -translate-y-1/2 w-5 h-5 text-[#3B82F6] pointer-events-none">
                    <ChevronDown className="w-full h-full" strokeWidth={3} />
                  </div>
                </div>
              </div>
            </div>

            <div class="space-y-2">
              <label for="message" class="clay-subtitle text-xs font-bold text-[#1C398E] uppercase tracking-widest ml-1">Your Message*</label>
              <textarea id="message" name="message" rows="4" required class="clay-input resize-none py-4" placeholder="How can we help you today?"></textarea>
            </div>

            <button type="submit" class="clay-button-primary w-full py-5 rounded-[2rem] font-black uppercase tracking-[0.2em] text-sm group">
              <span class="flex items-center justify-center gap-3">
                Send Request
                <Send className="w-5 h-5 group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" />
              </span>
            </button>
          </form>

          <!-- Trust Badges -->
          <div class="mt-10 pt-10 border-t border-[#1C398E]/5 flex flex-wrap justify-center gap-8">
            <div class="flex items-center gap-2 text-[10px] font-bold text-[#1C398E]/40 uppercase tracking-widest font-mono">
              <ShieldCheck className="w-4 h-4 text-[#16A34A]" />
              Secure Data
            </div>
            <div class="flex items-center gap-2 text-[10px] font-bold text-[#1C398E]/40 uppercase tracking-widest font-mono">
              <Zap className="w-4 h-4 text-[#D97706]" />
              Fast Response
            </div>
            <div class="flex items-center gap-2 text-[10px] font-bold text-[#1C398E]/40 uppercase tracking-widest font-mono">
              <BellOff className="w-4 h-4 text-[#DC2626]" />
              No Spam
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 2.5rem;
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.02), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.06);
    border: 1.5px solid rgba(255, 255, 255, 0.8);
  }

  .clay-card-form {
    background: #ffffff;
    border-radius: 3.5rem;
    padding: 3.5rem 2.5rem;
    box-shadow: 
      inset -12px -12px 24px rgba(0, 0, 0, 0.02), 
      inset 12px 12px 24px rgba(255, 255, 255, 0.9),
      30px 60px 100px rgba(28, 57, 142, 0.1);
    border: 2px solid rgba(255, 255, 255, 0.8);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  @media (max-width: 768px) {
    .clay-card-form {
      padding: 2rem 1.5rem;
      border-radius: 2.5rem;
    }
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-input {
    width: 100%;
    padding: 1.25rem 1.5rem;
    background: #F8FAFC;
    border: 2px solid transparent;
    border-radius: 1.5rem;
    box-shadow: 
      inset 6px 6px 12px rgba(28, 57, 142, 0.05),
      inset -6px -6px 12px rgba(255, 255, 255, 0.8);
    color: #1C398E;
    font-family: 'Montserrat', sans-serif;
    font-weight: 600;
    font-size: 0.875rem;
    transition: all 0.3s ease;
    outline: none;
  }

  .clay-input:focus {
    background: #FFFFFF;
    border-color: rgba(59, 130, 246, 0.3);
    box-shadow: 
      inset 2px 2px 4px rgba(28, 57, 142, 0.02),
      0 10px 20px rgba(59, 130, 246, 0.1);
  }

  .clay-button-primary {
    background: #3B82F6;
    color: #FFFFFF;
    box-shadow: 
      inset -4px -4px 8px rgba(0, 0, 0, 0.1), 
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      0 15px 30px rgba(59, 130, 246, 0.4);
    transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    cursor: pointer;
    border: none;
  }

  .clay-button-primary:hover {
    transform: translateY(-4px) scale(1.02);
    background: #2563EB;
    box-shadow: 
      inset -4px -4px 8px rgba(0, 0, 0, 0.1), 
      inset 4px 4px 8px rgba(255, 255, 255, 0.3),
      0 20px 40px rgba(59, 130, 246, 0.5);
  }

  .clay-button-primary:active {
    transform: translateY(0) scale(0.98);
    box-shadow: 
      inset 4px 4px 8px rgba(0, 0, 0, 0.1), 
      inset -4px -4px 8px rgba(255, 255, 255, 0.3);
  }

  .shadow-clayCard {
    box-shadow: 20px 40px 80px rgba(28, 57, 142, 0.1);
  }

  .shadow-clayButton {
    box-shadow: 5px 10px 20px rgba(28, 57, 142, 0.08);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate] {
    transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
