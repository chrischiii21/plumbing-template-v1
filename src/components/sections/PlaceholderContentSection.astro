---
import { getLocationText } from "@/config/brand-settings"

interface Props {
  title?: string;
  subtitle?: string;
  bgImage?: string;
}

const { 
  title: raw_title = "TO BE DETERMINED", 
  subtitle: raw_subtitle = "BASED ON THE CLIENT DISCOVERY CONVERSATION",
  bgImage
} = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const subtitle = raw_subtitle ? getLocationText(raw_subtitle) : raw_subtitle;
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="relative py-16 md:py-24 overflow-hidden bg-[#F0F4F9]">
  <!-- Decorative Background Blobs for Playful Vibe -->
  <div class="absolute top-[-5%] left-[-5%] w-[30%] h-[30%] bg-[#3B82F6]/10 rounded-full blur-[80px] animate-pulse"></div>
  <div class="absolute bottom-[-5%] right-[-5%] w-[20%] h-[20%] bg-[#3B82F6]/15 rounded-full blur-[60px]"></div>
  
  {bgImage && (
    <div class="absolute inset-0 opacity-5 mix-blend-overlay pointer-events-none">
      <img src={bgImage} alt="" class="w-full h-full object-cover" />
    </div>
  )}

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto">
      <!-- Claymorphism Card -->
      <div class="clay-card relative overflow-hidden group will-change-transform" data-animate="zoom-in">
        <!-- Floating Accent Bubble inside card -->
        <div class="absolute -top-8 -right-8 w-24 h-24 bg-[#3B82F6]/10 rounded-full transition-transform duration-700 group-hover:scale-110"></div>
        
        <div class="relative z-10 text-center transform-gpu">
          <div class="inline-block mb-4 px-4 py-1.5 bg-[#3B82F6]/10 rounded-full clay-badge">
            <span class="text-[0.65rem] font-mono font-bold tracking-[0.2em] text-[#3B82F6] uppercase">
              Section Placeholder
            </span>
          </div>

          <h2 class="clay-title text-3xl md:text-5xl font-extrabold mb-4 leading-tight tracking-tight">
            {title}
          </h2>

          <div class="w-16 h-1.5 bg-[#3B82F6] mx-auto mb-6 rounded-full shadow-[0_4px_12px_rgba(59,130,246,0.3)]"></div>

          {subtitle && (
            <p class="clay-subtitle text-base md:text-xl font-medium max-w-xl mx-auto leading-relaxed">
              {subtitle}
            </p>
          )}

          <!-- Interactive Clay Elements -->
          <div class="mt-8 flex justify-center gap-4">
            <div class="w-2.5 h-2.5 rounded-full bg-[#3B82F6] shadow-sm animate-bounce [animation-duration:2s]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#3B82F6]/60 shadow-sm animate-bounce [animation-duration:2s] [animation-delay:0.3s]"></div>
            <div class="w-2.5 h-2.5 rounded-full bg-[#3B82F6]/30 shadow-sm animate-bounce [animation-duration:2s] [animation-delay:0.6s]"></div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3rem;
    padding: 3rem 1.5rem;
    /* Advanced Claymorphism shadows for "puffy" look */
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.02), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.08);
    border: 1.5px solid rgba(255, 255, 255, 0.9);
    transition: all 0.5s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .clay-card:hover {
    transform: translateY(-5px) scale(1.005);
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.02), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.1);
  }

  .clay-badge {
    box-shadow: 
      inset -1px -1px 2px rgba(0, 0, 0, 0.05), 
      inset 1px 1px 2px rgba(255, 255, 255, 0.9);
  }

  @media (min-width: 768px) {
    .clay-card {
      padding: 4rem 3rem;
    }
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
    color: #1C398E; /* Text color from DESIGN.md */
    text-shadow: 0 4px 12px rgba(28, 57, 142, 0.05);
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
    color: color-mix(in srgb, #1C398E 65%, transparent);
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Custom animation for the card appearing */
  [data-animate="zoom-in"] {
    transition: all 1s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
