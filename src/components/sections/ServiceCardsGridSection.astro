---
import { getLocationText } from "@/config/brand-settings"
import { UtensilsCrossed, Bath, Droplets, Flame, Waves, Pipette } from "lucide-react"

interface ServiceCard {
  image: string;
  icon: string;
  title: string;
  href?: string;
}

interface Props {
  title: string;
  description?: string;
  services: ServiceCard[];
}

const { title: raw_title, description: raw_description, services } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : raw_title;
const description = raw_description ? getLocationText(raw_description) : raw_description;

const iconMap: Record<string, any> = {
  kitchen: UtensilsCrossed,
  bathroom: Bath,
  leak: Droplets,
  waterheater: Flame,
  drain: Waves,
  pipe: Pipette,
};
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-0 right-0 w-[50%] h-[50%] bg-[#3B82F6]/5 rounded-full blur-[120px] pointer-events-none"></div>
  <div class="absolute bottom-0 left-0 w-[40%] h-[40%] bg-[#16A34A]/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <!-- Header -->
    <div class="max-w-4xl mx-auto text-center mb-16 md:mb-20" data-animate="fade-up">
      <h2 class="clay-title text-3xl md:text-5xl font-black text-[#1C398E] mb-6 leading-tight tracking-tighter">{title}</h2>
      {description && <p class="clay-subtitle text-lg md:text-xl text-[#1C398E]/60 max-w-3xl mx-auto font-medium leading-relaxed" set:html={description} />}
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-10 lg:gap-12 max-w-7xl mx-auto" data-animate-stagger>
      {services.map((service) => {
        const IconComponent = iconMap[service.icon] || iconMap.kitchen;
        return (
          <a href={service.href || "/contact"} class="group block no-underline outline-none">
            <div class="clay-card relative h-full flex flex-col hover:-translate-y-4 transition-all duration-500 will-change-transform transform-gpu">
              
              <!-- Image Puffy Frame -->
              <div class="p-4 md:p-6 pb-0">
                <div class="aspect-[4/3] rounded-[2.5rem] overflow-hidden shadow-inner-clay relative group/img">
                  <img 
                    src={service.image} 
                    alt={service.title} 
                    class="w-full h-full object-cover transition-transform duration-[3000ms] group-hover/img:scale-110"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-[#1C398E]/40 to-transparent mix-blend-overlay"></div>
                  
                  {/* Icon Overlay Badge */}
                  <div class="absolute top-6 left-6 w-14 h-14 rounded-2xl bg-white/90 backdrop-blur-md flex items-center justify-center clay-badge-white group-hover:scale-110 transition-transform">
                    <IconComponent className="w-7 h-7 text-[#3B82F6]" strokeWidth={2.5} />
                  </div>
                </div>
              </div>
              
              <!-- Content -->
              <div class="p-8 md:p-10 pt-8 flex flex-col items-center text-center">
                <h3 class="clay-title text-xl font-black text-[#1C398E] leading-tight group-hover:text-[#3B82F6] transition-colors">{service.title}</h3>
              </div>

              {/* Background Micro-Accent */}
              <div class="absolute -bottom-6 -right-6 w-32 h-32 bg-[#3B82F6]/5 rounded-full blur-2xl group-hover:scale-150 transition-transform"></div>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>

<style>
  .clay-card {
    background: #ffffff;
    border-radius: 3.5rem;
    box-shadow: 
      inset -10px -10px 20px rgba(0, 0, 0, 0.02), 
      inset 10px 10px 20px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    border: 2px solid rgba(255, 255, 255, 0.9);
    backface-visibility: hidden;
    transform-style: preserve-3d;
  }

  .shadow-inner-clay {
    box-shadow: 
      inset 8px 8px 16px rgba(0, 0, 0, 0.1),
      inset -8px -8px 16px rgba(255, 255, 255, 0.2);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-badge-white {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.02), 
      inset 2px 2px 4px rgba(255, 255, 255, 1),
      10px 20px 40px rgba(28, 57, 142, 0.08);
  }

  .clay-button-mini {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.1), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.3),
      0 10px 20px rgba(59, 130, 246, 0.3);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  [data-animate-stagger] > * {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
