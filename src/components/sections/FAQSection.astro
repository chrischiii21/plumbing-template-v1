---
import { getLocationText } from "@/config/brand-settings"
import { ChevronDown, MessageCircleQuestion } from "lucide-react"

interface FAQItem {
  question: string;
  answer?: string;
}

interface Props {
  title: string;
  faqs: FAQItem[];
}

const { title: raw_title, faqs: rawFaqs } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : "";
const faqs = rawFaqs.map(faq => ({
  ...faq,
  question: getLocationText(faq.question),
  answer: faq.answer ? getLocationText(faq.answer) : undefined,
}));
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-1/4 -left-20 w-80 h-80 bg-[#3B82F6]/10 rounded-full blur-[100px] pointer-events-none animate-pulse"></div>
  <div class="absolute bottom-1/4 -right-20 w-64 h-64 bg-[#16A34A]/10 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="grid lg:grid-cols-12 gap-12 lg:gap-20 items-start">
      
      {/* Left Column: Interactive Header & CTA */}
      <div class="lg:col-span-5 space-y-10 sticky top-32" data-animate="fade-right">
        <div>
          <div class="inline-flex items-center gap-3 bg-white px-6 py-2 rounded-full clay-badge mb-8">
            <MessageCircleQuestion className="w-4 h-4 text-[#3B82F6]" />
            <span class="clay-subtitle text-[0.65rem] font-black uppercase tracking-[0.3em] text-[#3B82F6]">Support Center</span>
          </div>
          <h2 class="clay-title text-5xl md:text-6xl font-black text-[#1C398E] tracking-tighter leading-[1.1] mb-8">{title}</h2>
        </div>

        {/* Dynamic Clay CTA Card */}
        <div class="bg-white p-8 rounded-[40px] clay-card relative overflow-hidden group">
          <div class="relative z-10">
            <p class="clay-subtitle text-[#1C398E]/70 font-black uppercase tracking-[0.3em] text-[0.65rem] mb-6">
              Still have questions?
            </p>
            <a href="/contact" class="clay-btn-primary group inline-flex items-center gap-4 text-white px-8 py-4 font-black uppercase tracking-widest text-xs">
              Contact our team
              <svg class="group-hover:translate-x-1.5 transition-transform" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14m-7-7 7 7-7 7"/></svg>
            </a>
          </div>
          {/* Decorative Bubble */}
          <div class="absolute -right-8 -bottom-8 w-32 h-32 bg-[#3B82F6]/10 rounded-full blur-xl group-hover:scale-150 transition-transform duration-700"></div>
        </div>
      </div>
      
      {/* Right Column: FAQs Accordion List */}
      <div class="lg:col-span-7 space-y-6" data-animate-stagger>
        {faqs.map((faq, index) => (
          <details class="clay-accordion group relative overflow-hidden transition-all duration-500">
            <summary class="flex items-center justify-between p-7 md:p-9 cursor-pointer list-none outline-none">
              <span class="clay-title text-xl md:text-2xl font-black text-[#1C398E] tracking-tight leading-tight group-open:text-[#3B82F6] transition-colors">{faq.question}</span>
              <div class="w-12 h-12 rounded-2xl bg-white clay-badge-rect flex items-center justify-center text-[#3B82F6] group-open:rotate-180 transition-all duration-500 group-hover:scale-110 group-open:bg-[#3B82F6] group-open:text-white">
                <ChevronDown className="w-6 h-6" strokeWidth={3} />
              </div>
            </summary>
            {faq.answer && (
              <div class="px-7 pb-9 md:px-9 md:pb-12 pt-0">
                <div class="clay-subtitle text-[#1C398E]/90 font-medium leading-relaxed text-lg" set:html={faq.answer} />
              </div>
            )}
            
            {/* Subtle Gradient Glow inside active item */}
            <div class="absolute inset-0 bg-gradient-to-br from-[#3B82F6]/10 via-transparent to-transparent opacity-0 group-open:opacity-100 transition-opacity pointer-events-none"></div>
          </details>
        ))}
      </div>

    </div>
  </div>
</section>

<style>
  .clay-accordion {
    background: #ffffff;
    border-radius: 2.5rem;
    box-shadow: 
      20px 20px 40px rgba(28, 57, 142, 0.03),
      -10px -10px 20px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.6);
  }

  .clay-accordion:hover {
    box-shadow: 
      25px 25px 50px rgba(28, 57, 142, 0.05),
      -12px -12px 24px rgba(255, 255, 255, 1),
      inset 4px 4px 8px rgba(255, 255, 255, 0.9);
    transform: translateY(-4px);
  }

  .clay-accordion[open] {
    box-shadow: 
      inset 12px 12px 24px rgba(28, 57, 142, 0.03),
      inset -12px -12px 24px rgba(255, 255, 255, 0.8);
    background: #FAFCFF;
  }

  .clay-card {
    box-shadow: 
      30px 30px 60px rgba(28, 57, 142, 0.06),
      -15px -15px 30px rgba(255, 255, 255, 1),
      inset 4px 4px 12px rgba(255, 255, 255, 0.8);
    border: 2px solid rgba(255, 255, 255, 0.9);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-badge-rect {
    box-shadow: 
      8px 8px 16px rgba(28, 57, 142, 0.05),
      -4px -4px 8px rgba(255, 255, 255, 1),
      inset 2px 2px 4px rgba(255, 255, 255, 0.5);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  /* Hide default details arrow */
  summary::-webkit-details-marker {
    display: none;
  }

  /* Smooth accordion content transition */
  details > div {
    animation: slideDown 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
  }

  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-10px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Handle sticky positioning correctly on mobile */
  @media (max-width: 1024px) {
    .sticky {
      position: static !important;
    }
  }
  .shadow-clayButton {
    box-shadow: 
      6px 6px 12px rgba(28, 57, 142, 0.06),
      -6px -6px 12px rgba(255, 255, 255, 1),
      inset 3px 3px 6px rgba(255, 255, 255, 0.6),
      inset -3px -3px 6px rgba(28, 57, 142, 0.02);
  }

  .clay-btn-primary {
    background-color: #3B82F6;
    border-radius: 9999px;
    box-shadow: 
      8px 8px 16px rgba(59, 130, 246, 0.3),
      -4px -4px 8px rgba(255, 255, 255, 0.5),
      inset 4px 4px 8px rgba(255, 255, 255, 0.4),
      inset -4px -4px 8px rgba(28, 57, 142, 0.2);
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .clay-btn-primary:hover {
    background-color: #2563EB;
    transform: translateY(-2px);
    box-shadow: 
      12px 12px 20px rgba(59, 130, 246, 0.4),
      -4px -4px 8px rgba(255, 255, 255, 0.6),
      inset 4px 4px 8px rgba(255, 255, 255, 0.5),
      inset -4px -4px 8px rgba(28, 57, 142, 0.3);
  }

  .clay-btn-primary:active {
    transform: translateY(1px);
    box-shadow: 
      4px 4px 8px rgba(59, 130, 246, 0.2),
      -2px -2px 4px rgba(255, 255, 255, 0.4),
      inset 6px 6px 12px rgba(28, 57, 142, 0.3),
      inset -6px -6px 12px rgba(255, 255, 255, 0.2);
  }
</style>
