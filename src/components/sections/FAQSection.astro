---
import { getLocationText } from "@/config/brand-settings"
import { ChevronDown, MessageCircleQuestion } from "lucide-react"

interface FAQItem {
  question: string;
  answer?: string;
}

interface Props {
  title: string;
  faqs: FAQItem[];
}

const { title: raw_title, faqs: rawFaqs } = Astro.props;

// Process text placeholders
const title = raw_title ? getLocationText(raw_title) : "";
const faqs = rawFaqs.map(faq => ({
  ...faq,
  question: getLocationText(faq.question),
  answer: faq.answer ? getLocationText(faq.answer) : undefined,
}));
---

<!-- Claymorphism Design System Fonts -->
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Montserrat:wght@400;500;600;700&family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<section class="py-24 md:py-32 bg-[#F8FAFC] relative overflow-hidden">
  {/* Ambient Depth Elements */}
  <div class="absolute top-1/4 -left-20 w-80 h-80 bg-[#3B82F6]/5 rounded-full blur-[100px] pointer-events-none animate-pulse"></div>
  <div class="absolute bottom-1/4 -right-20 w-64 h-64 bg-[#16A34A]/5 rounded-full blur-[80px] pointer-events-none"></div>

  <div class="container mx-auto px-4 relative z-10">
    <div class="max-w-4xl mx-auto">
      <div class="text-center mb-16 md:mb-20" data-animate="fade-up">
        <div class="inline-flex items-center gap-3 bg-white px-6 py-2 rounded-full clay-badge mb-6">
          <MessageCircleQuestion className="w-4 h-4 text-[#3B82F6]" />
          <span class="text-[0.65rem] font-mono font-bold uppercase tracking-[0.25em] text-[#3B82F6]">Support Center</span>
        </div>
        <h2 class="clay-title text-4xl md:text-6xl font-black text-[#1C398E] tracking-tighter leading-tight mb-8">{title}</h2>
        <div class="w-24 h-2 bg-[#3B82F6] mx-auto rounded-full shadow-lg"></div>
      </div>
      
      <div class="space-y-6 md:space-y-8" data-animate-stagger>
        {faqs.map((faq, index) => (
          <details class="clay-accordion group relative overflow-hidden will-change-transform transform-gpu transition-all duration-500">
            <summary class="flex items-center justify-between p-6 md:p-8 cursor-pointer list-none outline-none">
              <span class="clay-title text-lg md:text-xl font-bold text-[#1C398E] pr-8 leading-snug group-open:text-[#3B82F6] transition-colors">{faq.question}</span>
              <div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-white clay-badge flex items-center justify-center text-[#3B82F6] group-open:rotate-180 transition-transform duration-500 shadow-sm group-hover:scale-110">
                <ChevronDown className="w-5 h-5 md:w-6 md:h-6" strokeWidth={3} />
              </div>
            </summary>
            {faq.answer && (
              <div class="px-6 pb-8 md:px-8 md:pb-10">
                <div class="w-full h-px bg-[#1C398E]/5 mb-6 md:mb-8 shadow-inner"></div>
                <div class="clay-subtitle text-[#1C398E]/60 font-medium leading-relaxed md:text-lg" set:html={faq.answer} />
              </div>
            )}
            
            {/* Subtle Gradient Glow inside active item */}
            <div class="absolute inset-0 bg-gradient-to-br from-[#3B82F6]/5 to-transparent opacity-0 group-open:opacity-100 transition-opacity pointer-events-none"></div>
          </details>
        ))}
      </div>

      <div class="mt-20 text-center" data-animate="fade-up">
        <p class="clay-subtitle text-[#1C398E]/40 font-bold uppercase tracking-[0.2em] text-xs">
          Still have questions? <a href="/contact" class="text-[#3B82F6] hover:underline decoration-2 underline-offset-4">Contact our team</a>
        </p>
      </div>
    </div>
  </div>
</section>

<style>
  .clay-accordion {
    background: #ffffff;
    border-radius: 2.5rem;
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.01), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      15px 30px 60px rgba(28, 57, 142, 0.05);
    border: 1.5px solid rgba(255, 255, 255, 0.8);
  }

  .clay-accordion:hover {
    box-shadow: 
      inset -8px -8px 16px rgba(0, 0, 0, 0.01), 
      inset 8px 8px 16px rgba(255, 255, 255, 0.9),
      20px 40px 80px rgba(28, 57, 142, 0.08);
    transform: translateY(-2px);
  }

  .clay-accordion[open] {
    box-shadow: 
      inset -4px -4px 8px rgba(0, 0, 0, 0.02), 
      inset 4px 4px 8px rgba(255, 255, 255, 0.9),
      10px 20px 40px rgba(28, 57, 142, 0.04);
    transform: scale(1.01);
  }

  .clay-badge {
    box-shadow: 
      inset -2px -2px 4px rgba(0, 0, 0, 0.05), 
      inset 2px 2px 4px rgba(255, 255, 255, 0.9),
      4px 8px 16px rgba(28, 57, 142, 0.05);
  }

  .clay-title {
    font-family: 'Poppins', sans-serif;
  }

  .clay-subtitle {
    font-family: 'Montserrat', sans-serif;
  }

  .font-mono {
    font-family: 'JetBrains Mono', monospace;
  }

  /* Hide default details arrow */
  summary::-webkit-details-marker {
    display: none;
  }

  [data-animate-stagger] > * {
    transition: all 0.8s cubic-bezier(0.34, 1.56, 0.64, 1);
  }
</style>
